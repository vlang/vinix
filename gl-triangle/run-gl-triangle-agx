#!/bin/sh
set -eu

unset LIBGL_ALWAYS_SOFTWARE
unset LIBGL_ALWAYS_INDIRECT
export EGL_PLATFORM=surfaceless
# Mesa selects Asahi or VirGL from the DRM driver name. An explicit override
# remains available to developers, but forcing Asahi here breaks VM testing.

triangle=/usr/bin/gl-triangle-agx
if [ "${1:-}" = --rebuild ] || [ "${1:-}" = --compile ]; then
    echo "run-gl-triangle-agx: compiling the demo with Vinix GCC"
    example=/usr/share/examples/gl-triangle
    source="$example/egl_triangle.c"
    if command -v v >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
        target_arch=arm64
        [ "$(uname -m)" != x86_64 ] || target_arch=amd64
        source=/tmp/gl-triangle-v.c
        python3 "$example/compile-v.py" "$source" --kind egl --arch "$target_arch"
    fi
    gcc "$source" -std=gnu11 -fwrapv -fno-strict-aliasing -I"$example" -O2 \
        -o /tmp/gl-triangle-agx -lEGL -lGLESv2 -ldl -lpthread -lm
    triangle=/tmp/gl-triangle-agx
    shift
fi

if [ ! -e /dev/dri/renderD128 ]; then
    echo "run-gl-triangle-agx: /dev/dri/renderD128 is unavailable" >&2
    exit 1
fi

if [ ! -x "$triangle" ]; then
    echo "run-gl-triangle-agx: accelerated triangle binary is unavailable" >&2
    exit 1
fi

exec "$triangle" "$@"
