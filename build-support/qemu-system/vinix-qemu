#!/bin/sh
# Boot a Vinix AArch64 raw boot image with software emulation inside Vinix.
set -eu

if [ "$#" -lt 1 ] || [ ! -f "$1" ]; then
    echo "usage: vinix-qemu /path/to/vinix-boot.img [QEMU options...]" >&2
    exit 2
fi
image=$1
shift

firmware=/usr/share/qemu/edk2-aarch64-code.fd
template=/usr/share/qemu/edk2-arm-vars.fd
if [ ! -f "$firmware" ] || [ ! -f "$template" ]; then
    echo 'Vinix QEMU firmware is missing; install the QEMU system layer.' >&2
    exit 1
fi

state_dir=${VINIX_QEMU_STATE_DIR:-"${HOME:-/root}/.vinix-qemu"}
mkdir -p "$state_dir"
vars=$state_dir/edk2-arm-vars.fd
if [ ! -f "$vars" ]; then
    cp "$template" "$vars"
fi

# QEMU's TCG emits writable executable code. Vinix enables that per process.
export VINIX_ALLOW_WX=1
# Do not add QEMU's default NIC: its UEFI network driver requires a trusted
# entropy source, which a nested Vinix boot may not have yet.
exec qemu-system-aarch64 \
    -machine virt,gic-version=3 -cpu max -accel tcg \
    -m "${VINIX_QEMU_GUEST_MEM:-2048}" -smp "${VINIX_QEMU_GUEST_SMP:-1}" \
    -display "${VINIX_QEMU_DISPLAY:-none}" -device ramfb -monitor none \
    -serial "${VINIX_QEMU_SERIAL:-stdio}" -no-reboot \
    -nic none \
    -device virtio-keyboard-device -device virtio-tablet-device \
    -drive "if=pflash,format=raw,unit=0,readonly=on,file=$firmware" \
    -drive "if=pflash,format=raw,unit=1,file=$vars" \
    -drive "if=none,id=boot,format=raw,file=$image" \
    -device virtio-blk-device,drive=boot "$@"
