#!/bin/sh
# Run an x86-64 Linux ELF through Vinix's AArch64 user-mode translator.
set -eu

runtime="${VINIX_X86_64_ROOT:-/usr/libexec/vinix-x86_64/root}"
emulator="${VINIX_X86_64_EMULATOR:-/usr/bin/qemu-x86_64}"

if [ "$#" -eq 0 ]; then
    echo "usage: run-x86-64 PROGRAM [ARGUMENT ...]" >&2
    exit 2
fi
if [ ! -x "$emulator" ]; then
    echo "run-x86-64: translator is not installed: $emulator" >&2
    exit 127
fi
if [ ! -e "$runtime/lib/ld-musl-x86_64.so.1" ]; then
    echo "run-x86-64: x86-64 runtime is not installed: $runtime" >&2
    exit 127
fi

program="$1"
shift
case "$program" in
    */*) ;;
    *)
        for directory in "$runtime/usr/bin" "$runtime/bin"; do
            if [ -x "$directory/$program" ]; then
                program="$directory/$program"
                break
            fi
        done
        ;;
esac
if [ ! -e "$program" ]; then
    echo "run-x86-64: program not found: $program" >&2
    exit 127
fi

guest_library_path="$runtime/lib:$runtime/usr/lib"
guest_base="${VINIX_X86_64_GUEST_BASE:-0x100000000}"
if [ -n "${VINIX_X86_64_LD_LIBRARY_PATH:-}" ]; then
    guest_library_path="$VINIX_X86_64_LD_LIBRARY_PATH:$guest_library_path"
fi

exec "$emulator" -B "$guest_base" -L "$runtime" \
    -E "LD_LIBRARY_PATH=$guest_library_path" "$program" "$@"
