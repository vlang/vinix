+#ifdef __APPLE__
+/* Apple's GL engine can dereference a null buffer-stamp pointer when any
+ * texture buffer is bound while another buffer is changed. Save and unbind
+ * texture-buffer bindings around buffer storage operations, then restore the
+ * bindings before rendering resumes. See Magnum's
+ * apple-buffer-texture-unbind-on-buffer-modify workaround:
+ * https://magnum.graphics/doc/magnum/opengl-workarounds.html
+ */
+struct vrend_apple_buffer_textures {
+   GLint active_texture;
+   GLint count;
+   GLuint *bound;
+   GLuint inline_bound[128];
+};
+
+static void vrend_apple_suspend_buffer_textures(struct vrend_apple_buffer_textures *state)
+{
+   memset(state, 0, sizeof(*state));
+   if (vrend_state.use_gles)
+      return;
+   glGetIntegerv(GL_ACTIVE_TEXTURE, &state->active_texture);
+   glGetIntegerv(GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS, &state->count);
+   if (state->count <= 0)
+      return;
+
+   state->bound = state->count <= ARRAY_SIZE(state->inline_bound) ?
+                  state->inline_bound : calloc(state->count, sizeof(GLuint));
+   if (!state->bound) {
+      virgl_error("Cannot save Apple texture-buffer bindings\n");
+      state->count = 0;
+      return;
+   }
+
+   for (GLint i = 0; i < state->count; i++) {
+      GLint texture = 0;
+      glActiveTexture(GL_TEXTURE0 + i);
+      glGetIntegerv(GL_TEXTURE_BINDING_BUFFER, &texture);
+      state->bound[i] = texture;
+      if (texture)
+         glBindTexture(GL_TEXTURE_BUFFER, 0);
+   }
+   glActiveTexture(state->active_texture);
+}
+
+static void vrend_apple_restore_buffer_textures(struct vrend_apple_buffer_textures *state)
+{
+   if (!state->bound)
+      return;
+   for (GLint i = 0; i < state->count; i++) {
+      if (state->bound[i]) {
+         glActiveTexture(GL_TEXTURE0 + i);
+         glBindTexture(GL_TEXTURE_BUFFER, state->bound[i]);
+      }
+   }
+   glActiveTexture(state->active_texture);
+   if (state->bound != state->inline_bound)
+      free(state->bound);
 }
+#endif
 
