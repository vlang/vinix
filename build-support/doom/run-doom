#!/bin/sh
# Launch Chocolate Doom on the private X11 display owned by vinix-wine-host.
set -eu

iwad=${VINIX_DOOM_IWAD:-/usr/share/games/doom/doom1.wad}
if [ ! -r "$iwad" ]; then
    echo "run-doom: no readable WAD at $iwad" >&2
    exit 1
fi

export HOME=${HOME:-/root}
export SDL_VIDEODRIVER=x11
export SDL_RENDER_DRIVER=software
# The kernel's sound card is an OSS /dev/dsp.
export SDL_AUDIODRIVER=${SDL_AUDIODRIVER:-dsp}
export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
mkdir -p "$XDG_CONFIG_HOME" /var/log

exec /usr/bin/chocolate-doom -iwad "$iwad" \
    -config /usr/share/games/doom/vinix.cfg -window -geometry 720x540 \
    -warp 1 1 "$@"
