--- a/common/lib/spinup.asm_aarch64
+++ b/common/lib/spinup.asm_aarch64
@@ -94,10 +94,34 @@
     // Enable AArch64 in EL1
     ldr x8, =0x80000002
     msr hcr_el2, x8
+    isb
 
+    // The write above also cleared E2H, unless the CPU keeps it set: Apple
+    // silicon has HCR_EL2.E2H fixed at 1. In that case CPTR_EL2 and
+    // CNTHCTL_EL2 stay in their VHE layouts, in which the value the non-VHE
+    // path writes to CPTR_EL2 (FPEN=0) traps every FP/SIMD instruction at EL1
+    // and EL0 to EL2, and CNTHCTL_EL2 needs EL1PCTEN/EL1PTEN rather than the
+    // bits set above for EL1 to reach the physical counter and timer.
+    mrs x8, hcr_el2
+    tbz x8, #34, 5f
+
+    // VHE layout, CPACR_EL1-shaped: FPEN=0b11, ZEN=0b11 mean "do not trap",
+    // leaving FP/SIMD policy to the kernel's own CPACR_EL1.
+    mov x8, #0x330000
+    msr cptr_el2, x8
+
+    // VHE layout: EL1PCTEN (bit 10) and EL1PTEN (bit 11).
+    mrs x8, cnthctl_el2
+    orr x8, x8, #(3 << 10)
+    msr cnthctl_el2, x8
+    b 6f
+
+5:
     // Don't trap FP/SIMD to EL2
     mov x8, #0x33FF
     msr cptr_el2, x8
+
+6:
     msr hstr_el2, xzr
 
     // Enter kernel in EL1
