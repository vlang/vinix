#!/bin/sh
# Atomically install a self-hosted desktop build and ask the PID 1 supervisor
# to replace the running session. The old executable remains valid until its
# process exits; every multicall application symlink sees the new inode.
set -eu

usage() {
	echo "usage: vinix-desktop-reload BINARY" >&2
	exit 2
}

[ "$#" -eq 1 ] || usage
source_binary=$1
[ -f "$source_binary" ] && [ -x "$source_binary" ] || {
	echo "vinix-desktop-reload: not an executable file: $source_binary" >&2
	exit 1
}

destination=/usr/bin/vinix-desktop
temporary="/usr/bin/.vinix-desktop.new.$$"
cleanup() {
	rm -f "$temporary"
}
trap cleanup EXIT HUP INT TERM

cp "$source_binary" "$temporary"
chmod 755 "$temporary"
mv -f "$temporary" "$destination"
mkdir -p /run
: > /run/vinix-desktop-development
# A compositor process can exist while blocked in its first application
# handshake. The replacement recreates this marker only once it has painted
# and finished those handshakes, giving diagnostics a real readiness signal.
# It is only that signal: on a disk-root machine /run is persistent, and a
# marker the kernel failed to unlink at boot can refuse removal with ENOENT.
rm -f /run/vinix-desktop-ready 2>/dev/null || \
	echo "vinix-desktop-reload: could not clear /run/vinix-desktop-ready; reloading anyway" >&2
trap - EXIT HUP INT TERM

echo "vinix-desktop-reload: installed $destination; reloading the desktop"
# Every multicall application runs this same executable, and pidof also
# matches /proc/<pid>/exe, so it reports Files and Terminal too. The
# compositor is the one whose own name is vinix-desktop.
desktop_pids=
for pid in $(/bin/busybox pidof vinix-desktop 2>/dev/null || true); do
	[ "$(cat "/proc/$pid/comm" 2>/dev/null)" = vinix-desktop ] || continue
	desktop_pids="$desktop_pids $pid"
done
set -- $desktop_pids
if [ "$#" -ne 1 ]; then
	echo "vinix-desktop-reload: expected one running desktop, found $#: ${desktop_pids:-none}" >&2
	exit 1
fi
# Signal the compositor itself. It execs the newly installed inode in place,
# preserving the framebuffer's graphics owner across the replacement. Sending
# this through PID 1 made the old process exit first, which briefly restored
# the full kernel boot console and looked like a machine crash/reboot.
kill -HUP "$1"
