#!/bin/sh
# Small Vinix frontend for Alpine's apk package manager.
set -eu

APK=${VINIX_PKG_APK:-/sbin/apk}
ROOT=${VINIX_PKG_ROOT:-}
RESOLV_CONF=${VINIX_PKG_RESOLV_CONF:-$ROOT/etc/resolv.conf}
NETWORK_RETRIES=${VINIX_PKG_NETWORK_RETRIES:-10}
NETWORK_RETRY_DELAY=${VINIX_PKG_NETWORK_RETRY_DELAY:-1}
NETWORK_WAIT_SECONDS=${VINIX_PKG_NETWORK_WAIT_SECONDS:-60}

usage() {
	cat <<'EOF'
usage: pkg <command> [package ...]

commands:
  install PACKAGE...  install packages (includes Vinix-ready GTK and Gnumeric)
  remove PACKAGE...   remove packages
  update              refresh Alpine repository indexes
  upgrade             upgrade installed packages
  search QUERY...     search available packages
  info PACKAGE...     show package information
  list                list installed packages

Alpine package names can be used directly. Vinix currently tracks Alpine 3.21
for aarch64; package changes affect the running root filesystem.
EOF
}

root_path() {
	printf '%s%s\n' "$ROOT" "$1"
}

apk() {
	if [ -n "$ROOT" ]; then
		"$APK" --root "$ROOT" "$@"
	else
		"$APK" "$@"
	fi
}

wait_for_network() {
	case "$NETWORK_RETRIES" in
		''|*[!0-9]*|0)
			echo "pkg: VINIX_PKG_NETWORK_RETRIES must be a positive integer" >&2
			exit 1
			;;
	esac
	case "$NETWORK_WAIT_SECONDS" in
		''|*[!0-9]*)
			echo "pkg: VINIX_PKG_NETWORK_WAIT_SECONDS must be a non-negative integer" >&2
			exit 1
			;;
	esac
	case "$NETWORK_RETRY_DELAY" in
		''|*[!0-9]*)
			echo "pkg: VINIX_PKG_NETWORK_RETRY_DELAY must be a non-negative integer" >&2
			exit 1
			;;
	esac

	i=0
	while [ ! -s "$RESOLV_CONF" ] && [ "$i" -lt "$NETWORK_WAIT_SECONDS" ]; do
		if [ "$i" -eq 0 ]; then
			echo "pkg: waiting for DHCP"
		fi
		sleep 1
		i=$((i + 1))
	done
	if [ ! -s "$RESOLV_CONF" ]; then
		echo "pkg: network is not ready: DHCP did not create $RESOLV_CONF" >&2
		return 1
	fi
}

# A package command can arrive just as DHCP or QEMU's DNS proxy comes up. apk
# reports that as a temporary repository error, then follows it with a long and
# misleading list of missing packages. Retry the whole safe/idempotent network
# transaction so a momentary miss cannot poison the first package install.
apk_network() {
	attempt=1
	while ! apk "$@"; do
		if [ "$attempt" -ge "$NETWORK_RETRIES" ]; then
			echo "pkg: package network operation failed after $attempt attempts" >&2
			return 1
		fi
		echo "pkg: package network operation failed; retrying ($attempt/$NETWORK_RETRIES)" >&2
		# Give QEMU's DNS proxy and the Alpine mirror progressively more time
		# without making the common first-boot retry feel like a long pause.
		sleep $((NETWORK_RETRY_DELAY * attempt))
		attempt=$((attempt + 1))
	done
}

# Download the complete dependency closure before changing the live root. A
# transient mirror failure near the end no longer leaves a half-installed GTK
# stack, and successful archives are retained across network retries. The final
# apk transaction is deliberately offline and keeps maintainer scripts disabled
# because they assume Alpine's init system.
apk_install() (
	wait_for_network
	cache_parent=$(root_path /var/cache)
	mkdir -p "$cache_parent"
	cache=$(mktemp -d "$cache_parent/vinix-pkg.XXXXXX")
	trap 'rm -rf "$cache"' EXIT INT TERM
	for index in "$(root_path /var/cache/apk)"/APKINDEX.*.tar.gz; do
		[ ! -f "$index" ] || cp "$index" "$cache/"
	done
	install_attempt=1
	while :; do
		apk_network --cache-dir "$cache" --no-progress cache download "$@"
		if apk --cache-dir "$cache" --no-network --no-progress --no-scripts add "$@"; then
			return 0
		fi
		if [ "$install_attempt" -ge "$NETWORK_RETRIES" ]; then
			echo "pkg: package installation failed after $install_attempt attempts" >&2
			return 1
		fi
		echo "pkg: package installation failed; refreshing downloads ($install_attempt/$NETWORK_RETRIES)" >&2
		rm -f "$cache"/*.apk
		sleep $((NETWORK_RETRY_DELAY * install_attempt))
		install_attempt=$((install_attempt + 1))
	done
)

have_repository_indexes() {
	for index in "$(root_path /var/cache/apk)"/APKINDEX.*.tar.gz; do
		[ -f "$index" ] && return 0
	done
	return 1
}

refresh_repository_indexes() {
	wait_for_network
	apk_network update
}

ensure_repository_indexes() {
	have_repository_indexes && return 0
	echo "pkg: refreshing Alpine repository indexes"
	refresh_repository_indexes
}

require_root() {
	if [ -z "$ROOT" ] && [ "$(id -u)" != 0 ]; then
		echo "pkg: package changes require root" >&2
		exit 1
	fi
}

# The userland builder extracts these packages so networking and apk work on
# the first boot. Register them as explicitly installed before the first
# transaction, otherwise removing an application could garbage-collect libc or
# apk itself as an apparently orphaned dependency.
bootstrap_database() {
	marker=$(root_path /var/lib/vinix-pkg/base-ready)
	[ -f "$marker" ] && return 0

	base_world=$(root_path /etc/vinix-pkg/base-world)
	if [ ! -s "$base_world" ]; then
		echo "pkg: missing $base_world" >&2
		exit 1
	fi

	echo "pkg: registering the Vinix base packages"
	# Package names cannot contain whitespace. Expanding this generated file is
	# intentional and preserves one package name per line as separate arguments.
	# shellcheck disable=SC2046
	apk_install $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$base_world")
	mkdir -p "$(dirname "$marker")"
	: > "$marker"
}

resolve_packages() {
	resolved=
	for requested in "$@"; do
		case "$requested" in
			gtk)
				# Keep GTK out of the image while making the obvious command
				# produce a complete, demonstrably useful desktop install.
				resolved="$resolved gtk+3.0 adwaita-icon-theme font-dejavu libarchive-tools"
				;;
			gnumeric)
				resolved="$resolved gnumeric adwaita-icon-theme font-dejavu"
				;;
			gtk+3.0-demo) ;;
			*) resolved="$resolved $requested" ;;
		esac
	done
	printf '%s\n' "${resolved# }"
}

install_packages() {
	for requested in "$@"; do
		case "$requested" in
			gtk)
				apk_install \
					adwaita-icon-theme font-dejavu gtk+3.0 libarchive-tools
				install_gtk_demo
				finalize_desktop
				;;
			gtk+3.0-demo)
				apk_install gtk+3.0 libarchive-tools
				install_gtk_demo
				finalize_desktop
				;;
			gnumeric)
				# Gnumeric's Alpine dependencies provide GTK itself, while these
				# theme/font packages make the application usable on a fresh Vinix
				# image that deliberately contains no desktop toolkit.
				apk_install \
					adwaita-icon-theme font-dejavu gnumeric
				finalize_gnumeric
				;;
			*)
				apk_install "$requested"
				;;
		esac
	done
}

install_gtk_demo() {
	if [ -n "$ROOT" ]; then
		apk_install gtk+3.0-demo
		return
	fi

	manifest=/var/lib/vinix-pkg/gtk+3.0-demo.files
	if [ -s "$manifest" ] \
		&& [ -x /usr/bin/gtk3-demo ] \
		&& [ -x /usr/bin/gtk3-widget-factory ]; then
		return 0
	fi

	# apk fetch verifies the repository signature and package checksum, but does
	# not enter apk's Vinix-incompatible large-file-list cleanup path. Extract
	# this data-only examples package and keep a manifest for symmetric removal.
	temp=$(/bin/busybox mktemp -d /tmp/vinix-pkg-gtk-demo.XXXXXX)
	trap 'rm -rf "$temp"' EXIT INT TERM
	mkdir "$temp/payload"
	apk_network --no-progress fetch --output "$temp" gtk+3.0-demo
	set -- "$temp"/gtk+3.0-demo-*.apk
	if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
		echo "pkg: apk did not fetch one GTK demo archive" >&2
		exit 1
	fi
	/usr/bin/bsdtar --ignore-zeros -xzf "$1" -C "$temp/payload"
	# Vinix creates regular files as 0644 and archive tools restore their final
	# modes with fchmodat. Make the package's application entries explicit too,
	# so a partial extractor cannot silently leave unusable examples behind.
	/bin/busybox chmod 0755 "$temp/payload"/usr/bin/gtk3-*
	if [ ! -x "$temp/payload/usr/bin/gtk3-demo" ] \
		|| [ ! -x "$temp/payload/usr/bin/gtk3-widget-factory" ]; then
		echo "pkg: GTK demo archive is missing its examples" >&2
		exit 1
	fi

	(
		cd "$temp/payload"
		/bin/busybox find . -type f
		/bin/busybox find . -type l
	) >"$temp/manifest"
	for entry in "$temp/payload"/*; do
		[ -e "$entry" ] || continue
		/bin/busybox cp -a "$entry" /
	done
	mkdir -p /var/lib/vinix-pkg
	/bin/busybox cp "$temp/manifest" "$manifest"
	rm -rf "$temp"
	trap - EXIT INT TERM
	echo "pkg: GTK demos installed"
}

finalize_desktop() {
	[ -n "$ROOT" ] && return 0
	# These are the deterministic cache updates from Alpine's triggers. General
	# maintainer scripts stay disabled because they assume Alpine's init system.
	/usr/bin/gdk-pixbuf-query-loaders --update-cache
	/usr/bin/glib-compile-schemas /usr/share/glib-2.0/schemas
	/usr/bin/update-mime-database /usr/share/mime
	/usr/bin/gtk-update-icon-cache -f -t /usr/share/icons/hicolor
	/usr/bin/gtk-update-icon-cache -f -t /usr/share/icons/Adwaita
}

finalize_gnumeric() {
	[ -n "$ROOT" ] && return 0
	# Alpine exposes the versioned executable through a relative symlink. apk's
	# fchmodat(2) mode restoration is not yet effective on Vinix, so restore the
	# package's executable bits and materialise its small command launcher.
	if [ ! -x /usr/bin/gnumeric ]; then
		set -- /usr/bin/gnumeric-[0-9]*
		if [ "$#" -ne 1 ] || [ ! -s "$1" ]; then
			echo "pkg: Gnumeric package has no executable launcher" >&2
			exit 1
		fi
		# Keep all of Gnumeric's command-line tools usable too, as the GTK demo
		# installer does for its extracted archive.
		/bin/busybox chmod 0755 "$1" /usr/bin/ssconvert /usr/bin/ssdiff \
			/usr/bin/ssgrep /usr/bin/ssindex
		/bin/busybox rm -f /usr/bin/gnumeric
		/bin/busybox cp "$1" /usr/bin/gnumeric
		/bin/busybox chmod 0755 /usr/bin/gnumeric
	fi
	# Loader and schema caches are required for application startup. Gnumeric
	# does not require rebuilding the desktop MIME/icon indexes, whose scanners
	# can monopolise Vinix's sole QEMU CPU after this much larger transaction.
	/usr/bin/gdk-pixbuf-query-loaders --update-cache
	/usr/bin/glib-compile-schemas /usr/share/glib-2.0/schemas
	/usr/bin/update-mime-database /usr/share/mime
}

remove_gtk_demo() {
	if [ -n "$ROOT" ]; then
		apk --no-progress --no-scripts del gtk+3.0-demo
		return
	fi

	manifest=/var/lib/vinix-pkg/gtk+3.0-demo.files
	[ -s "$manifest" ] || return 0
	while IFS= read -r path; do
		case "$path" in
			./usr/*|./etc/*) rm -f "/${path#./}" ;;
		esac
	done <"$manifest"
	rm -f "$manifest"
}

if [ "$#" -eq 0 ]; then
	usage
	exit 1
fi

command_name=$1
shift

case "$command_name" in
	help|-h|--help)
		usage
		;;
	install|add)
		[ "$#" -gt 0 ] || { echo "pkg: install needs a package name" >&2; exit 1; }
		require_root
		ensure_repository_indexes
		bootstrap_database
		install_packages "$@"
		;;
	remove|delete|del)
		[ "$#" -gt 0 ] || { echo "pkg: remove needs a package name" >&2; exit 1; }
		require_root
		ensure_repository_indexes
		bootstrap_database
		for requested in "$@"; do
			case "$requested" in
				gtk|gtk+3.0-demo) remove_gtk_demo ;;
			esac
		done
		packages=$(resolve_packages "$@")
		if [ -n "$packages" ]; then
			# shellcheck disable=SC2086
			apk --no-progress --no-scripts del $packages
		fi
		;;
	update)
		[ "$#" -eq 0 ] || { echo "pkg: update takes no packages" >&2; exit 1; }
		require_root
		refresh_repository_indexes
		;;
	upgrade)
		[ "$#" -eq 0 ] || { echo "pkg: upgrade takes no packages" >&2; exit 1; }
		require_root
		refresh_repository_indexes
		bootstrap_database
		apk_network --no-progress --no-scripts upgrade
		;;
	search)
		[ "$#" -gt 0 ] || { echo "pkg: search needs a query" >&2; exit 1; }
		ensure_repository_indexes
		apk search "$@"
		;;
	info)
		[ "$#" -gt 0 ] || { echo "pkg: info needs a package name" >&2; exit 1; }
		apk info "$@"
		;;
	list)
		[ "$#" -eq 0 ] || { echo "pkg: list takes no packages" >&2; exit 1; }
		apk info
		[ ! -s "$(root_path /var/lib/vinix-pkg/gtk+3.0-demo.files)" ] \
			|| echo gtk+3.0-demo
		;;
	*)
		echo "pkg: unknown command: $command_name" >&2
		usage >&2
		exit 1
		;;
esac
