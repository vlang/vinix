+	gunichar2 *characters = g_utf8_to_utf16(header, -1, NULL, &length, NULL);
+	g_free(header);
+	if (!characters || length > INT_MAX) {
+		g_free(characters);
+		cookie_store_exception(env);
+		return NULL;
+	}
+	jstring result = (*env)->NewString(env, (const jchar *)characters, (jsize)length);
+	g_free(characters);
+	return result;
+}
