+/* Keep the base first; each archive remains an untouched, separate file. */
+static char *build_apk_archive_paths(const char *base_path, char **split_paths, GError **error)
+{
+	GPtrArray *paths = g_ptr_array_new_with_free_func(free);
+	for (size_t i = 0; i == 0 || (split_paths && split_paths[i - 1]); i++) {
+		const char *input = i == 0 ? base_path : split_paths[i - 1];
+		char *path = realpath(input, NULL);
+		struct stat st;
+		if (!path || strchr(path, ':') || stat(path, &st) || !S_ISREG(st.st_mode) || access(path, R_OK)) {
+			g_set_error(error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+			            "APK path must be a readable regular file without ':': %s", input);
+			free(path);
+			g_ptr_array_unref(paths);
+			return NULL;
+		}
+		for (guint j = 0; j < paths->len; j++) {
+			if (!strcmp(path, g_ptr_array_index(paths, j))) {
+				g_set_error(error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Repeated APK path: %s", input);
+				free(path);
+				g_ptr_array_unref(paths);
+				return NULL;
+			}
+		}
+		g_ptr_array_add(paths, path);
+	}
+	GString *classpath = g_string_new(NULL);
+	for (guint i = 0; i < paths->len; i++) {
+		if (i) g_string_append_c(classpath, ':');
+		g_string_append(classpath, g_ptr_array_index(paths, i));
+	}
+	g_ptr_array_unref(paths);
+	return g_string_free(classpath, FALSE);
+}
 
