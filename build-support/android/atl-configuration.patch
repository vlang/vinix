+	double raw_x, raw_y;
+	if (!gdk_event_get_position(event, &raw_x, &raw_y)) return FALSE;
+	double x = raw_x, y = raw_y;
+	transform_coords_to_widget_relative(GTK_WIDGET(wrapper), &x, &y);
+	int buttons = mouse_buttons(gdk_event_get_modifier_state(event));
+	int button = 0;
