+		XFreeEventData(display, &event.xcookie);
+		if (before >= 0 && s->active) emit(s, before, 0, 0, 0, 0, 0, time);
+		if (s->generation == generation && action >= 0 && s->active)
+			emit(s, action, button, dx, dy, sx, sy, time);
+		if (s->generation == generation && after >= 0 && s->active)
+			emit(s, after, 0, 0, 0, 0, 0, time);
+	}
+	gboolean alive = s->generation == generation && s->display == display;
+	g_object_unref(root);
+	capture_unref(s);
+	return alive ? G_SOURCE_CONTINUE : G_SOURCE_REMOVE;
+}
+#endif
+
+gboolean atl_pointer_capture_has(GtkWidget *widget)
+{
+#ifdef GDK_WINDOWING_X11
+	GtkRoot *root = gtk_widget_get_root(widget);
+	Capture *s = root ? g_object_get_data(G_OBJECT(root), CAPTURE_KEY) : NULL;
+	return s && s->active;
+#else
+	(void)widget;
+	return FALSE;
+#endif
+}
+
+guint64 atl_pointer_capture_epoch(GtkWidget *widget)
+{
+#ifdef GDK_WINDOWING_X11
+	GtkRoot *root = gtk_widget_get_root(widget);
+	Capture *s = root ? g_object_get_data(G_OBJECT(root), CAPTURE_KEY) : NULL;
+	return s ? s->generation : 0;
+#else
+	(void)widget;
+	return 0;
+#endif
+}
+
+void atl_pointer_capture_release(GtkWidget *widget)
+{
+#ifdef GDK_WINDOWING_X11
+	GtkRoot *root = gtk_widget_get_root(widget);
+	Capture *s = root ? g_object_get_data(G_OBJECT(root), CAPTURE_KEY) : NULL;
+	if (s) release(s, TRUE);
+#else
+	(void)widget;
+#endif
+}
+
+gboolean atl_pointer_capture_request(GtkWidget *owner, AtlCapturedEvent event,
+                                     AtlCaptureChanged changed, gpointer data,
+                                     GDestroyNotify destroy)
+{
+#ifdef GDK_WINDOWING_X11
+	GtkRoot *root = gtk_widget_get_root(owner);
+	if (!root || !GTK_IS_WINDOW(root) || !gtk_widget_get_mapped(GTK_WIDGET(root))
+	    || !gtk_window_is_active(GTK_WINDOW(root))) return FALSE;
+	GdkDisplay *gdk_display = gtk_widget_get_display(owner);
+	if (!GDK_IS_X11_DISPLAY(gdk_display)) return FALSE;
+	Capture *s = g_object_get_data(G_OBJECT(root), CAPTURE_KEY);
+	if (s && s->active) return FALSE;
+	Display *display = XOpenDisplay(gdk_display_get_name(gdk_display));
+	if (!display) return FALSE;
+	int opcode, base_event, base_error, major = 2, minor = 1;
+	if (!XQueryExtension(display, "XInputExtension", &opcode, &base_event, &base_error)
+	    || XIQueryVersion(display, &major, &minor) != Success
+	    || major < 2 || (major == 2 && minor < 1)) { XCloseDisplay(display); return FALSE; }
+	GdkSeat *seat = gdk_display_get_default_seat(gdk_display);
+	/* A master grab includes its attached pointing devices. Until separate
+	 * tablet/touch grab routing exists, refuse capture on mixed seats rather
+	 * than stealing input from other devices. The production X11 seat is a
+	 * mouse plus keyboard. Unsupported backends/seats retain normal input. */
+	GList *devices = gdk_seat_get_devices(seat, GDK_SEAT_CAPABILITY_ALL_POINTING);
+	gboolean mouse_only = TRUE;
+	for (GList *it = devices; it; it = it->next)
+		if (gdk_device_get_source(it->data) != GDK_SOURCE_MOUSE) mouse_only = FALSE;
+	g_list_free(devices);
+	if (!mouse_only) { XCloseDisplay(display); return FALSE; }
+	GdkDevice *pointer = gdk_seat_get_pointer(seat);
+	if (!pointer) { XCloseDisplay(display); return FALSE; }
+	int device_id = gdk_x11_device_get_id(pointer);
+	Window window = gdk_x11_surface_get_xid(gtk_native_get_surface(GTK_NATIVE(root)));
+	char empty[] = {0};
+	Pixmap bitmap = XCreateBitmapFromData(display, window, empty, 1, 1);
+	XColor color = {0};
+	Cursor cursor = XCreatePixmapCursor(display, bitmap, bitmap, &color, &color, 0, 0);
+	XFreePixmap(display, bitmap);
+	unsigned char mask[XIMaskLen(XI_LASTEVENT)] = {0};
+	XISetMask(mask, XI_Motion); XISetMask(mask, XI_ButtonPress); XISetMask(mask, XI_ButtonRelease);
+	XIEventMask events = { device_id, sizeof(mask), mask };
+	int status = XIGrabDevice(display, device_id, window, CurrentTime, cursor,
+	                          XIGrabModeAsync, XIGrabModeAsync, False, &events);
+	/* Do not steal GDK's implicit/explicit grab: its old normal touch/click
+	 * stream must receive its release/cancel. A request may be retried after
+	 * that stream ends. Other clients' grabs are preserved too. */
+	if (status != GrabSuccess) { XFreeCursor(display, cursor); XCloseDisplay(display); return FALSE; }
+	/* XI2.1 provides a defined sourceid. Selecting raw events only on the
+	 * root avoids duplicate delivery through the grab mask. Relative
+	 * valuator deltas continue even at screen/window edges. */
+	memset(mask, 0, sizeof(mask)); XISetMask(mask, XI_RawMotion);
+	XIEventMask raw_events = { XIAllMasterDevices, sizeof(mask), mask };
+	XISelectEvents(display, DefaultRootWindow(display), &raw_events, 1);
+	XSelectInput(display, window, FocusChangeMask | StructureNotifyMask);
+	XSync(display, False);
+	Window query_root = None, query_child = None; double root_x = 0, root_y = 0;
+	XIButtonState buttons = {0}; XIModifierState mods = {0}; XIGroupState group = {0};
+	double last_x = 0, last_y = 0;
+	int initial_buttons = 0;
+	Bool queried = XIQueryPointer(display, device_id, window, &query_root, &query_child,
+	               &root_x, &root_y, &last_x, &last_y, &buttons, &mods, &group);
+	if (buttons.mask) {
+		for (int i = 1; i < buttons.mask_len * 8; i++)
+			if (XIMaskIsSet(buttons.mask, i)) initial_buttons |= android_button(i);
+		XFree(buttons.mask);
+	}
+	if (!queried) {
+		XIUngrabDevice(display, device_id, CurrentTime);
+		XFreeCursor(display, cursor); XCloseDisplay(display); return FALSE;
+	}
+	if (!s) {
+		s = g_new0(Capture, 1); g_ref_count_init(&s->refs); s->root = GTK_WIDGET(root);
+		g_object_set_data_full(G_OBJECT(root), CAPTURE_KEY, s, capture_destroy);
+		GtkEventController *controller = gtk_event_controller_legacy_new();
+		gtk_event_controller_set_propagation_phase(controller, GTK_PHASE_CAPTURE);
+		g_signal_connect(controller, "event", G_CALLBACK(suppress_normal_mouse), s);
+		gtk_widget_add_controller(GTK_WIDGET(root), controller);
+		g_signal_connect(root, "unmap", G_CALLBACK(on_unmap), s);
+		g_signal_connect(root, "notify::is-active", G_CALLBACK(on_active), s);
+		g_signal_connect_object(seat, "device-added", G_CALLBACK(on_device_added), root, G_CONNECT_SWAPPED);
+	}
+	s->generation++;
+	s->active = TRUE; s->display = display; s->window = window;
+	s->cursor = cursor; s->device_id = device_id; s->opcode = opcode;
+	s->source_id = -1; s->buttons = initial_buttons; s->warp_pending = FALSE;
+	s->last_x = last_x; s->last_y = last_y;
+	s->entry_root_x = root_x; s->entry_root_y = root_y;
+	s->event = event; s->changed = changed; s->data = data; s->destroy = destroy;
+	s->source = g_unix_fd_add(ConnectionNumber(display), G_IO_IN | G_IO_HUP | G_IO_ERR, input_ready, s);
+	/* Notify before any input callback; notification may release/reacquire. */
+	guint64 generation = s->generation;
+	capture_ref(s);
+	g_object_ref(root);
+	if (s->generation == generation && changed) changed(GTK_WIDGET(root), TRUE, data);
+	/* XIQueryPointer may already have queued input in Xlib's private buffer. */
+	if (s->generation == generation && s->display == display && XPending(display))
+		input_ready(ConnectionNumber(display), G_IO_IN, s);
+	g_object_unref(root);
+	capture_unref(s);
+	return TRUE;
+#else
+	(void)owner; (void)event; (void)changed; (void)data; (void)destroy;
+	return FALSE;
+#endif
+}
