+	private static void validateSplitArchives(String[] archivePaths, PackageParser.Package pkg) throws IOException {
+		if (archivePaths.length == 1) return;
+		String[] splitPaths = new String[archivePaths.length - 1];
+		String[] splitNames = new String[splitPaths.length];
+		HashSet<String> paths = new HashSet<>();
+		HashSet<String> names = new HashSet<>();
+		paths.add(new File(archivePaths[0]).getCanonicalPath());
+		final String androidNamespace = "http://schemas.android.com/apk/res/android";
+		HashSet<String> componentTags = new HashSet<>(Arrays.asList("activity", "activity-alias", "service", "receiver", "provider", "uses-split"));
+		for (int i = 1; i < archivePaths.length; i++) {
+			File file = new File(archivePaths[i]).getCanonicalFile();
+			if (!file.isFile() || !file.canRead() || !paths.add(file.getPath())) {
+				throw new IOException("Unreadable or repeated split APK: " + archivePaths[i]);
+			}
+			requireArchiveManifest(file.getPath());
+			try (JarFile jar = new JarFile(file)) {
+				Enumeration<JarEntry> entries = jar.entries();
+				while (entries.hasMoreElements()) {
+					String name = entries.nextElement().getName();
+					if (name.matches("classes[0-9]*\\.dex")) {
+						throw new IOException("Split APK DEX code is not supported: " + file);
+					}
+				}
+			}
+			AssetManager assets = new AssetManager();
+			XmlResourceParser parser = null;
+			try {
+				assets.addAssetPath(file.getPath());
+				parser = assets.openXmlResourceParser(0, "AndroidManifest.xml");
+				int type;
+				do { type = parser.next(); } while (type != XmlPullParser.START_TAG && type != XmlPullParser.END_DOCUMENT);
+				if (type != XmlPullParser.START_TAG || !"manifest".equals(parser.getName())) {
+					throw new IOException("Split APK has no manifest root: " + file);
+				}
+				String splitName = parser.getAttributeValue(null, "split");
+				String dependency = parser.getAttributeValue(null, "configForSplit");
+				if (dependency == null) dependency = parser.getAttributeValue(androidNamespace, "configForSplit");
+				if (parser.getAttributeBooleanValue(androidNamespace, "isFeatureSplit", false)
+				    || (dependency != null && !dependency.isEmpty())) {
+					throw new IOException("Feature and dependent split APKs are not supported: " + file);
+				}
+				if (!pkg.packageName.equals(parser.getAttributeValue(null, "package"))
+				    || pkg.mVersionCode != parser.getAttributeIntValue(androidNamespace, "versionCode", -1)
+				    || splitName == null || splitName.isEmpty() || !names.add(splitName)) {
