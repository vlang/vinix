index 0000000..6389010
--- /dev/null
+++ b/src/api-impl-jni/views/PointerCapture.c
@@ -0,0 +1,395 @@
+#include "PointerCapture.h"
+#include <glib-unix.h>
+#include <string.h>
+#ifdef GDK_WINDOWING_X11
+#include <gdk/x11/gdkx.h>
+#include <X11/Xlib.h>
+#include <X11/extensions/XInput2.h>
+#endif
+
+/* Pointer capture belongs to the attached window, as on Android. */
+#define CAPTURE_KEY "atl-pointer-capture"
+#ifdef GDK_WINDOWING_X11
+typedef struct {
+	grefcount refs;
+	GtkWidget *root; /* root owns this state */
+	gboolean active;
+	Display *display;
+	Window window;
+	Cursor cursor;
+	int device_id, opcode, source_id;
+	gboolean relative_source;
+	guint64 generation;
+	guint source;
+	unsigned long warp_serial;
+	gboolean warp_pending;
+	double last_x, last_y, center_x, center_y;
+	double entry_root_x, entry_root_y;
+	int buttons;
+	AtlCapturedEvent event;
+	AtlCaptureChanged changed;
+	gpointer data;
+	GDestroyNotify destroy;
+} Capture;
+
+static Capture *capture_ref(Capture *s) { g_ref_count_inc(&s->refs); return s; }
+static void capture_unref(Capture *s) { if (g_ref_count_dec(&s->refs)) g_free(s); }
+
+static void release(Capture *s, gboolean notify)
+{
+	if (!s->active) return;
+	Display *display = s->display;
+	gpointer data = s->data;
+	GDestroyNotify destroy = s->destroy;
+	AtlCaptureChanged changed = s->changed;
+	/* Clear and dispose the old acquisition before calling Java: a callback
+	 * may immediately request a new grab, even on another window. */
+	s->generation++;
+	s->active = FALSE;
+	s->display = NULL;
+	s->data = NULL;
+	if (s->source) { g_source_remove(s->source); s->source = 0; }
+	/* The hidden pointer returns to its entry position before becoming
+	 * visible. Root coordinates avoid a destroyed application-window XID. */
+	XIWarpPointer(display, s->device_id, None, DefaultRootWindow(display),
+	              0, 0, 0, 0, s->entry_root_x, s->entry_root_y);
+	XIUngrabDevice(display, s->device_id, CurrentTime);
+	XFreeCursor(display, s->cursor);
+	XSync(display, False);
+	XCloseDisplay(display);
+	if (notify && changed) changed(s->root, FALSE, data);
+	if (destroy) destroy(data);
+}
+
+static void capture_destroy(gpointer data)
+{
+	Capture *s = data;
+	release(s, FALSE);
+	capture_unref(s);
+}
+
+static void on_unmap(GtkWidget *widget, Capture *s) { (void)widget; release(s, TRUE); }
+static void on_active(GObject *root, GParamSpec *param, Capture *s)
+{
+	(void)param;
+	if (!gtk_window_is_active(GTK_WINDOW(root))) release(s, TRUE);
+}
+
+static void on_device_added(GtkWidget *root, GdkDevice *device)
+{
+	GdkInputSource source = gdk_device_get_source(device);
+	if (source != GDK_SOURCE_MOUSE && source != GDK_SOURCE_KEYBOARD) {
+		Capture *s = g_object_get_data(G_OBJECT(root), CAPTURE_KEY);
+		if (s) release(s, TRUE);
+	}
+}
+
+static gboolean suppress_normal_mouse(GtkEventControllerLegacy *controller, GdkEvent *event, gpointer data)
+{
+	(void)controller;
+	Capture *s = data;
+	if (!s->active) return FALSE;
+	GdkDevice *device = gdk_event_get_device(event);
+	if (!device || gdk_device_get_source(device) != GDK_SOURCE_MOUSE
+	    || gdk_event_get_pointer_emulated(event) || gdk_event_get_device_tool(event)) return FALSE;
+	switch (gdk_event_get_event_type(event)) {
+	case GDK_MOTION_NOTIFY: case GDK_BUTTON_PRESS: case GDK_BUTTON_RELEASE:
+	case GDK_SCROLL: case GDK_ENTER_NOTIFY: case GDK_LEAVE_NOTIFY:
+		return TRUE;
+	default: return FALSE;
+	}
+}
+
+static int android_button(int button)
+{
+	switch (button) {
+	case 1: return 1; /* primary */
+	case 3: return 2; /* secondary */
+	case 2: return 4; /* tertiary */
+	case 8: return 8; /* back */
+	case 9: return 16; /* forward */
+	default: return 0;
+	}
+}
+
+static void emit(Capture *s, int action, int action_button, double dx, double dy,
+                 double scroll_x, double scroll_y, Time time)
+{
+	GtkWidget *root = g_object_ref(s->root);
+	GtkWidget *focused = gtk_root_get_focus(GTK_ROOT(root));
+	if (!focused) { g_object_unref(root); return; }
+	GtkWidget *owner = g_object_ref(focused);
+	double scale = gtk_widget_get_scale_factor(root);
+	/* The callback may release capture/remove the view. It receives only
+	 * numeric copies; both native objects stay alive until it returns. */
+	s->event(owner, action, s->buttons, action_button, dx / scale, dy / scale,
+	         s->last_x / scale, s->last_y / scale, scroll_x, scroll_y,
+	         (guint32)time, s->data);
+	g_object_unref(owner);
+	g_object_unref(root);
+}
+
+static void source_changed(Capture *s, int source_id)
+{
+	if (source_id == s->source_id) return;
+	s->source_id = source_id;
+	s->relative_source = FALSE;
+	int count;
+	XIDeviceInfo *info = XIQueryDevice(s->display, source_id, &count);
+	gboolean relative_x = FALSE, relative_y = FALSE;
+	if (info && count) {
+		for (int i = 0; i < info[0].num_classes; i++) {
+			if (info[0].classes[i]->type != XIValuatorClass) continue;
+			XIValuatorClassInfo *v = (XIValuatorClassInfo *)info[0].classes[i];
+			if (v->number == 0) relative_x = v->mode == XIModeRelative;
+			if (v->number == 1) relative_y = v->mode == XIModeRelative;
+		}
+	}
+	if (info) XIFreeDeviceInfo(info);
+	s->relative_source = relative_x && relative_y;
+}
+
+static gboolean input_ready(gint fd, GIOCondition condition, gpointer data)
+{
+	(void)fd;
+	Capture *s = capture_ref(data);
+	if (condition & (G_IO_HUP | G_IO_ERR)) { release(s, TRUE); capture_unref(s); return G_SOURCE_REMOVE; }
+	/* Keep the window alive if a listener closes it while this source runs. */
+	GtkWidget *root = g_object_ref(s->root);
+	Display *display = s->display;
+	guint64 generation = s->generation;
+	while (s->generation == generation && s->display == display && XPending(display)) {
+		XEvent event;
+		XNextEvent(display, &event);
+		/* GDK may retain is-active during an external XI2 pointer grab.
+		 * Observe real X focus/unmap events on this connection too. Ignore
+		 * grab pseudo-focus and transitions into this window's descendants. */
+		if ((event.type == FocusOut && event.xfocus.mode != NotifyGrab
+		     && event.xfocus.mode != NotifyUngrab && event.xfocus.detail != NotifyInferior)
+		    || event.type == UnmapNotify || event.type == DestroyNotify) {
+			release(s, TRUE);
+			break;
+		}
+		if (event.type != GenericEvent || event.xcookie.extension != s->opcode
+		    || !XGetEventData(display, &event.xcookie)) continue;
+		/* Copy cookie data before calling Java, which may close this Display. */
+		int type = event.xcookie.evtype;
+		Time time = 0;
+		int action = -1, button = 0, before = -1, after = -1;
+		double dx = 0, dy = 0, sx = 0, sy = 0;
+		if (type == XI_RawMotion) {
+			XIRawEvent *e = event.xcookie.data;
+			if (e->deviceid != s->device_id) { XFreeEventData(display, &event.xcookie); continue; }
+			source_changed(s, e->sourceid);
+			time = e->time;
+			if (s->relative_source) {
+				double *v = e->raw_values;
+				for (int axis = 0; axis < e->valuators.mask_len * 8; axis++) {
+					if (!XIMaskIsSet(e->valuators.mask, axis)) continue;
+					if (axis == 0) dx = *v;
+					if (axis == 1) dy = *v;
+					v++;
+				}
+				if (dx || dy) action = 2; /* ACTION_MOVE */
+			}
+		} else if (type == XI_Motion || type == XI_ButtonPress || type == XI_ButtonRelease) {
+			XIDeviceEvent *e = event.xcookie.data;
+			source_changed(s, e->sourceid);
+			time = e->time;
+			if (type == XI_Motion) {
+				if (!s->relative_source) {
+					/* Absolute devices/XTEST need recentering. Xlib exposes the
+					 * request serial, so queued pre-warp input is never mistaken
+					 * for the synthetic recenter motion. */
+					gboolean warp = s->warp_pending && e->serial >= s->warp_serial
+					    && e->event_x == s->center_x && e->event_y == s->center_y;
+					if (warp) s->warp_pending = FALSE;
+					else { dx = e->event_x - s->last_x; dy = e->event_y - s->last_y; if (dx || dy) action = 2; }
+				}
+				s->last_x = e->event_x;
+				s->last_y = e->event_y;
+				int width = gtk_widget_get_width(root) * gtk_widget_get_scale_factor(root);
+				int height = gtk_widget_get_height(root) * gtk_widget_get_scale_factor(root);
+				if (!s->relative_source && !s->warp_pending && width > 4 && height > 4
+				    && (s->last_x < 2 || s->last_y < 2 || s->last_x >= width - 2 || s->last_y >= height - 2)) {
+					s->center_x = width / 2;
+					s->center_y = height / 2;
+					s->warp_serial = NextRequest(display);
+					s->warp_pending = TRUE;
+					XIWarpPointer(display, s->device_id, None, s->window, 0, 0, 0, 0, s->center_x, s->center_y);
+					XFlush(display);
+				}
+			} else {
+				button = android_button(e->detail);
+				if (button) {
+					int previous = s->buttons;
+					if (type == XI_ButtonPress) {
+						s->buttons |= button; action = 11;
+						before = (!(previous & 7) && (s->buttons & 7)) ? 0 : 2;
+					} else {
+						s->buttons &= ~button; action = 12;
+						after = ((previous & 7) && !(s->buttons & 7)) ? 1 : 2;
+					}
+				} else if (type == XI_ButtonPress && e->detail >= 4 && e->detail <= 7) {
+					before = 2; action = 8;
+					if (e->detail == 4) sy = 1;
+					if (e->detail == 5) sy = -1;
+					if (e->detail == 6) sx = -1;
+					if (e->detail == 7) sx = 1;
+				}
+			}
