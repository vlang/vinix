+JNIEXPORT jstring JNICALL Java_android_webkit_CookieManager_nativeGetCookie(
+		JNIEnv *env, jclass type, jstring url)
+{
+	(void)type;
+	char *url_utf8 = cookie_string_utf8(env, url);
+	if (!url_utf8)
+		return NULL;
+	g_mutex_lock(&cookie_store_mutex);
+	gboolean initialized = initialize_cookie_store_locked();
+	char *header = initialized ? get_cookie_locked(url_utf8) : NULL;
+	g_mutex_unlock(&cookie_store_mutex);
+	g_free(url_utf8);
+	if (!initialized) {
+		cookie_store_exception(env);
+		return NULL;
+	}
+	if (!header)
+		return NULL;
