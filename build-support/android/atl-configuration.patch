+					}
+				}
+				splitPaths[i - 1] = file.getPath();
+				splitNames[i - 1] = splitName;
+			} catch (XmlPullParserException e) {
+				throw new IOException("Failed to parse split APK: " + file, e);
+			} finally {
+				if (parser != null) parser.close();
+				assets.close();
+			}
+		}
+		pkg.applicationInfo.splitSourceDirs = splitPaths;
+		pkg.applicationInfo.splitPublicSourceDirs = splitPaths.clone();
+		pkg.splitNames = splitNames;
+	}
