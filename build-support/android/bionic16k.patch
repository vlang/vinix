+/* Android's public netdb flags and EAI enum are a different ABI from
+ * glibc/musl. Keep translation at the Bionic boundary; native ART continues
+ * to use its host constants and result codes. */
+enum {
+	BIONIC_AI_PASSIVE = 1, BIONIC_AI_CANONNAME = 2,
+	BIONIC_AI_NUMERICHOST = 4, BIONIC_AI_NUMERICSERV = 8,
+	BIONIC_AI_ALL = 0x100, BIONIC_AI_ADDRCONFIG = 0x400,
+	BIONIC_AI_V4MAPPED = 0x800,
+	BIONIC_NI_NOFQDN = 1, BIONIC_NI_NUMERICHOST = 2,
+	BIONIC_NI_NAMEREQD = 4, BIONIC_NI_NUMERICSERV = 8,
+	BIONIC_NI_DGRAM = 16, BIONIC_NI_WITHSCOPEID = 32,
+	BIONIC_EAI_ADDRFAMILY = 1, BIONIC_EAI_AGAIN = 2,
+	BIONIC_EAI_BADFLAGS = 3, BIONIC_EAI_FAIL = 4,
+	BIONIC_EAI_FAMILY = 5, BIONIC_EAI_MEMORY = 6,
+	BIONIC_EAI_NODATA = 7, BIONIC_EAI_NONAME = 8,
+	BIONIC_EAI_SERVICE = 9, BIONIC_EAI_SOCKTYPE = 10,
+	BIONIC_EAI_SYSTEM = 11, BIONIC_EAI_BADHINTS = 12,
+	BIONIC_EAI_PROTOCOL = 13, BIONIC_EAI_OVERFLOW = 14
+};
+
+static int bionic_eai_from_host(int error)
+{
+	if (!error) return 0;
+	if (error == EAI_AGAIN) return BIONIC_EAI_AGAIN;
+	if (error == EAI_BADFLAGS) return BIONIC_EAI_BADFLAGS;
+	if (error == EAI_FAIL) return BIONIC_EAI_FAIL;
+	if (error == EAI_FAMILY) return BIONIC_EAI_FAMILY;
+	if (error == EAI_MEMORY) return BIONIC_EAI_MEMORY;
+	if (error == EAI_NONAME) return BIONIC_EAI_NONAME;
+	if (error == EAI_SERVICE) return BIONIC_EAI_SERVICE;
+	if (error == EAI_SOCKTYPE) return BIONIC_EAI_SOCKTYPE;
+	if (error == EAI_SYSTEM) return BIONIC_EAI_SYSTEM;
+	if (error == EAI_OVERFLOW) return BIONIC_EAI_OVERFLOW;
+#ifdef EAI_ADDRFAMILY
+	if (error == EAI_ADDRFAMILY) return BIONIC_EAI_ADDRFAMILY;
+#endif
+#ifdef EAI_NODATA
+	if (error == EAI_NODATA) return BIONIC_EAI_NODATA;
+#endif
+#ifdef EAI_BADHINTS
+	if (error == EAI_BADHINTS) return BIONIC_EAI_BADHINTS;
+#endif
+#ifdef EAI_PROTOCOL
+	if (error == EAI_PROTOCOL) return BIONIC_EAI_PROTOCOL;
+#endif
+	return BIONIC_EAI_FAIL;
+}
+
+const char *bionic_gai_strerror(int error)
+{
+	switch (error) {
+	case 0: return "Success";
+#ifdef EAI_ADDRFAMILY
+	case BIONIC_EAI_ADDRFAMILY: return gai_strerror(EAI_ADDRFAMILY);
+#else
+	case BIONIC_EAI_ADDRFAMILY: return gai_strerror(EAI_FAMILY);
+#endif
+	case BIONIC_EAI_AGAIN: return gai_strerror(EAI_AGAIN);
+	case BIONIC_EAI_BADFLAGS: return gai_strerror(EAI_BADFLAGS);
+	case BIONIC_EAI_FAIL: return gai_strerror(EAI_FAIL);
+	case BIONIC_EAI_FAMILY: return gai_strerror(EAI_FAMILY);
+	case BIONIC_EAI_MEMORY: return gai_strerror(EAI_MEMORY);
+#ifdef EAI_NODATA
+	case BIONIC_EAI_NODATA: return gai_strerror(EAI_NODATA);
+#else
+	case BIONIC_EAI_NODATA: return gai_strerror(EAI_NONAME);
+#endif
+	case BIONIC_EAI_NONAME: return gai_strerror(EAI_NONAME);
+	case BIONIC_EAI_SERVICE: return gai_strerror(EAI_SERVICE);
+	case BIONIC_EAI_SOCKTYPE: return gai_strerror(EAI_SOCKTYPE);
+	case BIONIC_EAI_SYSTEM: return gai_strerror(EAI_SYSTEM);
+	case BIONIC_EAI_BADHINTS: return "Invalid value for hints";
+	case BIONIC_EAI_PROTOCOL: return "Resolved protocol is unknown";
+	case BIONIC_EAI_OVERFLOW: return gai_strerror(EAI_OVERFLOW);
+	default: return "Unknown error";
+	}
+}
+
+int bionic_getnameinfo(const struct sockaddr *address, socklen_t length,
+	char *host, size_t host_length, char *service, size_t service_length,
+	int flags)
+{
+	const int known = BIONIC_NI_NOFQDN | BIONIC_NI_NUMERICHOST |
+		BIONIC_NI_NAMEREQD | BIONIC_NI_NUMERICSERV | BIONIC_NI_DGRAM |
+		BIONIC_NI_WITHSCOPEID;
+	if (flags & ~known) return BIONIC_EAI_BADFLAGS;
+	int host_flags = 0;
+	if (flags & BIONIC_NI_NOFQDN) host_flags |= NI_NOFQDN;
+	if (flags & BIONIC_NI_NUMERICHOST) host_flags |= NI_NUMERICHOST;
+	if (flags & BIONIC_NI_NAMEREQD) host_flags |= NI_NAMEREQD;
+	if (flags & BIONIC_NI_NUMERICSERV) host_flags |= NI_NUMERICSERV;
+	if (flags & BIONIC_NI_DGRAM) host_flags |= NI_DGRAM;
+	/* glibc/musl already append a scoped numeric IPv6 address's interface
+	 * identifier. Platforms with an explicit scope flag receive it too. */
+#ifdef NI_WITHSCOPEID
+	if (flags & BIONIC_NI_WITHSCOPEID) host_flags |= NI_WITHSCOPEID;
+#endif
+	/* Android's LP64 ABI uses size_t for these bounds; the host uses
+	 * socklen_t. Capping a wider bound preserves every possible resolver
+	 * output while preventing a valid large bound from wrapping to zero. */
+#if SIZE_MAX > UINT_MAX
+	if (host_length > UINT_MAX) host_length = UINT_MAX;
+	if (service_length > UINT_MAX) service_length = UINT_MAX;
+#endif
+	return bionic_eai_from_host(getnameinfo(address, length, host,
+		(socklen_t)host_length, service, (socklen_t)service_length, host_flags));
+}
