diff --git a/linker/dlfcn.c b/linker/dlfcn.c
--- a/linker/dlfcn.c
+++ b/linker/dlfcn.c
@@ -55 +55,25 @@
-static pthread_mutex_t apkenv_dl_lock = PTHREAD_MUTEX_INITIALIZER;
+/* Constructors may legitimately call dlopen/dlsym/dlclose recursively. */
+static pthread_mutex_t apkenv_dl_lock;
+static pthread_once_t apkenv_dl_lock_once = PTHREAD_ONCE_INIT;
+
+static void apkenv_init_dl_lock(void)
+{
+	pthread_mutexattr_t attributes;
+	int error = pthread_mutexattr_init(&attributes);
+	if (error == 0) {
+		error = pthread_mutexattr_settype(&attributes, PTHREAD_MUTEX_RECURSIVE);
+		if (error == 0)
+			error = pthread_mutex_init(&apkenv_dl_lock, &attributes);
+		pthread_mutexattr_destroy(&attributes);
+	}
+	if (error != 0) {
+		fprintf(stderr, "bionic loader mutex initialization failed: %s\n", strerror(error));
+		abort();
+	}
+}
+
+static void apkenv_lock_loader(void)
+{
+	pthread_once(&apkenv_dl_lock_once, apkenv_init_dl_lock);
+	pthread_mutex_lock(&apkenv_dl_lock);
+}
