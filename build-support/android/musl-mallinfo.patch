+int __vinix_malloc_stats(struct vinix_malloc_stats *out, size_t size)
+{
+	if (!out || size != sizeof(*out)) {
+		errno = EINVAL;
+		return -1;
+	}
+	int saved_errno = errno;
+	wrlock();
+	*out = ctx.stats;
+	unlock();
+	errno = saved_errno;
+	return 0;
+}
