+/* All accounting runs under the existing malloc lock (or while musl knows
+ * the process has one thread). Its atfork protocol therefore covers both
+ * allocator state and snapshots without introducing another inherited lock. */
+static inline size_t stats_mapping_size(size_t len)
+{
+	return (len + PGSZ - 1) & -PGSZ;
+}
+
+static inline void stats_mapping_add(size_t len)
+{
+	ctx.stats.mapped_bytes += stats_mapping_size(len);
+	ctx.stats.mapped_blocks++;
+	if (ctx.stats.mapped_bytes > ctx.stats.peak_mapped_bytes)
+		ctx.stats.peak_mapped_bytes = ctx.stats.mapped_bytes;
 }
 
+static inline void stats_mapping_remove(size_t len)
+{
+	size_t bytes = stats_mapping_size(len);
+	assert(ctx.stats.mapped_bytes >= bytes && ctx.stats.mapped_blocks);
+	ctx.stats.mapped_bytes -= bytes;
+	ctx.stats.mapped_blocks--;
+}
+
+static inline void stats_mapping_resize(size_t old_len, size_t new_len)
+{
+	size_t old_bytes = stats_mapping_size(old_len);
+	size_t new_bytes = stats_mapping_size(new_len);
+	assert(ctx.stats.mapped_bytes >= old_bytes);
+	ctx.stats.mapped_bytes = ctx.stats.mapped_bytes - old_bytes + new_bytes;
+	if (ctx.stats.mapped_bytes > ctx.stats.peak_mapped_bytes)
+		ctx.stats.peak_mapped_bytes = ctx.stats.mapped_bytes;
+}
+
+static inline void stats_free_add(size_t bytes, size_t blocks)
+{
+	ctx.stats.free_bytes += bytes;
+	ctx.stats.free_blocks += blocks;
+}
+
+static inline void stats_free_remove(size_t bytes, size_t blocks)
+{
+	assert(ctx.stats.free_bytes >= bytes && ctx.stats.free_blocks >= blocks);
+	ctx.stats.free_bytes -= bytes;
+	ctx.stats.free_blocks -= blocks;
+}
+
+static inline void stats_payload_resize(size_t old_size, size_t new_size)
+{
+	assert(ctx.stats.live_bytes >= old_size);
+	ctx.stats.live_bytes = ctx.stats.live_bytes - old_size + new_size;
+	if (ctx.stats.live_bytes > ctx.stats.peak_live_bytes)
+		ctx.stats.peak_live_bytes = ctx.stats.live_bytes;
+}
