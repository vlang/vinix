#!/bin/sh
# Install host cross-builds into the running QEMU guest without restarting it.
set -eu

url_file=/etc/vinix/qemu-host-source-url
[ -s "$url_file" ] || exit 0
base_url=$(cat "$url_file")
case "$base_url" in http://10.0.2.2:*) ;; *) exit 0 ;; esac

destination=/usr/bin/vinix-files
version_file=/run/vinix-files-version
binary_url="${base_url%/}/vinix-files"
installed=
[ ! -s "$version_file" ] || installed=$(cat "$version_file")

while :; do
    version=$(/usr/bin/curl --fail --silent --show-error --connect-timeout 2 \
        --max-time 5 "$binary_url/version" 2>/dev/null || true)
    if ! printf '%s\n' "$version" | /bin/busybox awk 'NF == 2 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { valid = 1 } END { exit !valid }'; then
        sleep 2
        continue
    fi
    if [ "$version" != "$installed" ]; then
        temporary="/usr/bin/.vinix-files.new.$$"
        if /usr/bin/curl --fail --silent --show-error --connect-timeout 2 \
            --max-time 120 -o "$temporary" "$binary_url/binary"; then
            if command -v cksum >/dev/null 2>&1; then
                checksum=$(cksum "$temporary" | /bin/busybox awk '{print $1, $2}')
            else
                checksum=$(/bin/busybox cksum "$temporary" | /bin/busybox awk '{print $1, $2}')
            fi
            if [ "$checksum" = "$version" ]; then
                chmod 755 "$temporary"
                mv -f "$temporary" "$destination"
                printf '%s\n' "$version" > "$version_file"
                installed=$version
                echo "vinix-files-sync: installed new Files binary"
            fi
        fi
        rm -f "$temporary"
    fi
    sleep 2
done
