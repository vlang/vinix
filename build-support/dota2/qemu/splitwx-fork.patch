+#ifdef TCG_SPLITWX_FORK
+/*
+ * Called by fork_start() with every vCPU stopped, so no translation or
+ * jump patching runs while the used part of the buffer is copied.
+ */
+void tcg_region_fork_start(void)
+{
+    const size_t page_size = qemu_real_host_page_size();
+    uint8_t *start = region.start_aligned;
+    Error *err = NULL;
+    size_t used = 0;
+    void *copy;
+    int fd;
+
+    if (tcg_splitwx_diff == 0 || splitwx_map_size == 0) {
+        return;
+    }
+    for (unsigned int i = 0; i < qatomic_read(&tcg_cur_ctxs); i++) {
+        const TCGContext *s = qatomic_read(&tcg_ctxs[i]);
+        size_t end = (uint8_t *)qatomic_read(&s->code_gen_ptr) - start;
+
+        used = MAX(used, end);
+    }
+    used = MIN(ROUND_UP(used, page_size), splitwx_map_size);
+
+    copy = qemu_memfd_alloc("tcg-jit", splitwx_map_size, 0, &fd, &err);
+    if (copy == NULL) {
+        /* The child refuses to run on the shared buffer; see fork_end. */
+        error_report_err(err);
+        return;
+    }
+    memcpy(copy, start, used);
+    munmap(copy, splitwx_map_size);
+    splitwx_fork_fd = fd;
+    splitwx_fork_used = used;
+}
+
+void tcg_region_fork_end(bool child)
+{
+    const size_t page_size = qemu_real_host_page_size();
+    uint8_t *rw = region.start_aligned;
+    uint8_t *rx = rw + tcg_splitwx_diff;
+    int fd = splitwx_fork_fd;
+
+    if (tcg_splitwx_diff == 0 || splitwx_map_size == 0) {
+        return;
+    }
+    splitwx_fork_fd = -1;
+    if (child) {
+        if (fd < 0) {
+            error_report("jit split-wx: no private code buffer after fork");
+            _exit(EXIT_FAILURE);
+        }
+        /* The child is single-threaded: nothing runs translated code here. */
+        if (mmap(rw, splitwx_map_size, PROT_READ | PROT_WRITE,
+                 MAP_SHARED | MAP_FIXED, fd, 0) == MAP_FAILED ||
+            mmap(rx, splitwx_map_size, host_prot_read_exec(),
+                 MAP_SHARED | MAP_FIXED, fd, 0) == MAP_FAILED) {
+            error_report("jit split-wx: cannot map the private code buffer "
+                         "after fork: %s", strerror(errno));
+            _exit(EXIT_FAILURE);
+        }
+        /* Restore the guard pages tcg_region_init() set in the rw view. */
+        for (size_t i = 0; i < region.n; i++) {
+            void *start, *end;
+
+            tcg_region_bounds(i, &start, &end);
+            (void)qemu_mprotect_none(end, page_size);
+        }
+        flush_idcache_range((uintptr_t)rx, (uintptr_t)rw, splitwx_fork_used);
+    }
+    if (fd >= 0) {
+        close(fd);
+    }
+}
