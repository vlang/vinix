+/* Vinix: on a Vulkan 1.3 renderer, unlink the feature structs of the
+ * promoted dynamic state extensions (see vn_physical_device_init_features).
+ * Returns how many links changed; vn_device_relink_promoted_structs
+ * restores the application's chain after the renderer call.
+ */
+static uint32_t
+vn_device_unlink_promoted_structs(const struct vn_physical_device *physical_dev,
+                                  const VkDeviceCreateInfo *create_info,
+                                  VkBaseOutStructure **links,
+                                  VkBaseOutStructure **removed)
+{
+   VkBaseOutStructure *prev = (VkBaseOutStructure *)create_info;
+   uint32_t count = 0;
+
+   if (physical_dev->renderer_version < VK_API_VERSION_1_3)
+      return 0;
+   while (prev->pNext && count < 2) {
+      VkBaseOutStructure *next = prev->pNext;
+      if (next->sType ==
+             VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTENDED_DYNAMIC_STATE_FEATURES_EXT ||
+          next->sType ==
+             VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTENDED_DYNAMIC_STATE_2_FEATURES_EXT) {
+         links[count] = prev;
+         removed[count++] = next;
+         prev->pNext = next->pNext;
+         continue;
+      }
+      prev = next;
+   }
+   return count;
 }
 
+static void
+vn_device_relink_promoted_structs(uint32_t count, VkBaseOutStructure **links,
+                                  VkBaseOutStructure **removed)
+{
+   while (count--)
+      links[count]->pNext = removed[count];
+}
