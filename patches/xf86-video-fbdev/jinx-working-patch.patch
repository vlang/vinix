+
+static void
+FBDevTryGlamor(ScrnInfoPtr pScrn)
+{
+	FBDevPtr fPtr = FBDEVPTR(pScrn);
+	const char *method = xf86GetOptValString(fPtr->Options, OPTION_ACCEL_METHOD);
+	const char *node = xf86GetOptValString(fPtr->Options, OPTION_RENDER_NODE);
+	const char *force_software = getenv("VINIX_FORCE_SOFTWARE_GL");
+	void *module;
+
+	if ((method && !xf86NameCmp(method, "none")) ||
+	    (force_software && !strcmp(force_software, "1")))
+		return;
+	if (!node)
+		node = "/dev/dri/renderD128";
+	fPtr->renderFD = open(node, O_RDWR | O_CLOEXEC);
+	if (fPtr->renderFD < 0)
+		return;
+
+	module = xf86LoadSubModule(pScrn, "glamoregl");
+	if (!module)
+		goto fail;
+	fPtr->glamorEglInit = LoaderSymbolFromModule(module, "glamor_egl_init");
+	fPtr->glamorInit = LoaderSymbolFromModule(module, "glamor_init");
+	if (!fPtr->glamorEglInit || !fPtr->glamorInit)
+		goto fail;
+	if (!fPtr->glamorEglInit(pScrn, fPtr->renderFD))
+		goto fail;
+
+	fPtr->glamor = TRUE;
+	/* The framebuffer remains firmware-owned. DRI3 pixmaps render on AGX and
+	 * glamor downloads the completed root image before shadowfb copies it. */
+	fPtr->shadowFB = TRUE;
+	xf86DrvMsg(pScrn->scrnIndex, X_INFO,
+	           "using glamor/DRI3 acceleration through %s\n", node);
+	return;
+
+fail:
+	close(fPtr->renderFD);
+	fPtr->renderFD = -1;
+	xf86DrvMsg(pScrn->scrnIndex, X_WARNING,
+	           "M1 render node is present but glamor initialization failed; using software\n");
 }
 
