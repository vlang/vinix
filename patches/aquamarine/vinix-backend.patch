+    blueLength  = variable.blue.length;
+    framebufferLength = (size_t)stride * height;
+    framebuffer = mmap(nullptr, framebufferLength, PROT_READ | PROT_WRITE, MAP_SHARED, framebufferFD, 0);
+    if (framebuffer == MAP_FAILED) {
+        write(STDERR_FILENO, "aquamarine: cannot map Vinix framebuffer\n", sizeof("aquamarine: cannot map Vinix framebuffer\n") - 1);
+        framebuffer = nullptr;
+        backend->log(AQ_LOG_ERROR, std::format("vinix: cannot map /dev/fb0: {}", strerror(errno)));
+        teardownVinix();
+        return false;
+    }
+
+    drmfd = open("/dev/dri/renderD128", O_RDWR | O_CLOEXEC);
+    if (drmfd < 0)
+        drmfd = open("/dev/dri/card0", O_RDWR | O_CLOEXEC);
+    if (drmfd < 0) {
+        write(STDERR_FILENO, "aquamarine: cannot open Vinix DRM allocator\n", sizeof("aquamarine: cannot open Vinix DRM allocator\n") - 1);
+        backend->log(AQ_LOG_ERROR, "vinix: no DRM render device is available");
+        teardownVinix();
+        return false;
+    }
+
+    pointerFD = open("/dev/pointer", O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    pointer   = makeShared<CVinixPointer>();
+    keyboard  = makeShared<CVinixKeyboard>();
+
+    oldStdinFlags = fcntl(STDIN_FILENO, F_GETFL);
+    if (oldStdinFlags >= 0)
+        fcntl(STDIN_FILENO, F_SETFL, oldStdinFlags | O_NONBLOCK);
+    if (tcgetattr(STDIN_FILENO, &oldTermios) == 0) {
+        hasOldTermios = true;
+        auto raw = oldTermios;
+        raw.c_iflag &= (tcflag_t)~(IGNBRK | BRKINT | PARMRK | ISTRIP | INLCR | IGNCR | ICRNL | IXON);
+        raw.c_oflag &= (tcflag_t)~OPOST;
+        raw.c_lflag &= (tcflag_t)~(ECHO | ECHONL | ICANON | IEXTEN | ISIG);
+        raw.c_cflag &= (tcflag_t)~(CSIZE | PARENB);
+        raw.c_cflag |= CS8;
+        raw.c_cc[VMIN] = 0;
+        raw.c_cc[VTIME] = 0;
+        tcsetattr(STDIN_FILENO, TCSANOW, &raw);
+    }
+
+    inputTimerFD = timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC);
+    if (inputTimerFD < 0) {
+        write(STDERR_FILENO, "aquamarine: cannot create Vinix input timer\n", sizeof("aquamarine: cannot create Vinix input timer\n") - 1);
+        backend->log(AQ_LOG_ERROR, "vinix: cannot create the input timer");
+        teardownVinix();
+        return false;
+    }
+    itimerspec tick = {.it_interval = {.tv_sec = 0, .tv_nsec = 8'000'000}, .it_value = {.tv_sec = 0, .tv_nsec = 8'000'000}};
+    if (timerfd_settime(inputTimerFD, 0, &tick, nullptr) < 0) {
+        write(STDERR_FILENO, "aquamarine: cannot arm Vinix input timer\n", sizeof("aquamarine: cannot arm Vinix input timer\n") - 1);
+        backend->log(AQ_LOG_ERROR, "vinix: cannot arm the input timer");
+        teardownVinix();
+        return false;
+    }
+
+    write(STDERR_FILENO, "aquamarine: Vinix framebuffer backend ready\n", sizeof("aquamarine: Vinix framebuffer backend ready\n") - 1);
+    backend->log(AQ_LOG_DEBUG, std::format("vinix: using /dev/fb0 at {}x{} and DRM fd {}", width, height, drmfd));
+    return true;
+}
+
+void Aquamarine::CHeadlessBackend::teardownVinix() {
+    if (hasOldTermios)
+        tcsetattr(STDIN_FILENO, TCSANOW, &oldTermios);
+    hasOldTermios = false;
+    if (oldStdinFlags >= 0)
+        fcntl(STDIN_FILENO, F_SETFL, oldStdinFlags);
+    oldStdinFlags = -1;
+    if (framebuffer)
+        munmap(framebuffer, framebufferLength);
+    framebuffer = nullptr;
+    for (int* fd : {&inputTimerFD, &pointerFD, &drmfd, &framebufferFD}) {
+        if (*fd >= 0)
+            close(*fd);
+        *fd = -1;
+    }
+}
+
+bool Aquamarine::CHeadlessBackend::presentVinix(SP<IBuffer> buffer) {
+    if (!framebuffer || !buffer)
+        return false;
+
+    // KMS consumes the input fence asynchronously. This backend instead
+    // crosses straight from GL to a CPU framebuffer copy, so finish the
+    // current render before mapping its buffer.
+    glFinish();
+
+    auto [source, format, length] = buffer->beginDataPtr(GBM_BO_TRANSFER_READ);
+    if (!source || !height) {
+        backend->log(AQ_LOG_ERROR, "vinix: compositor buffer cannot be mapped for display");
+        return false;
+    }
+
+    const size_t sourceStride = length / (size_t)buffer->size.y;
+    const uint32_t copyWidth = std::min(width, (uint32_t)buffer->size.x);
+    const uint32_t copyHeight = std::min(height, (uint32_t)buffer->size.y);
+    auto* destination = static_cast<uint8_t*>(framebuffer);
+    const bool framebufferIsXRGB = redOffset == 16 && greenOffset == 8 && blueOffset == 0 && redLength == 8 && greenLength == 8 && blueLength == 8;
+    const bool sourceIsRGB = format == DRM_FORMAT_XRGB8888 || format == DRM_FORMAT_ARGB8888;
+
+    if (framebufferIsXRGB && sourceIsRGB) {
+        for (uint32_t y = 0; y < copyHeight; ++y)
+            memcpy(destination + (size_t)y * stride, source + (size_t)y * sourceStride, (size_t)copyWidth * 4);
+    } else {
+        for (uint32_t y = 0; y < copyHeight; ++y) {
+            const auto* src = reinterpret_cast<const uint32_t*>(source + (size_t)y * sourceStride);
+            auto* dst = reinterpret_cast<uint32_t*>(destination + (size_t)y * stride);
+            for (uint32_t x = 0; x < copyWidth; ++x) {
+                uint32_t pixel = src[x];
+                uint32_t r = 0, g = 0, b = 0;
+                if (sourceIsRGB) {
+                    r = (pixel >> 16) & 0xFF;
+                    g = (pixel >> 8) & 0xFF;
+                    b = pixel & 0xFF;
+                } else {
+                    r = pixel & 0xFF;
+                    g = (pixel >> 8) & 0xFF;
+                    b = (pixel >> 16) & 0xFF;
+                }
+                dst[x] = (r << redOffset) | (g << greenOffset) | (b << blueOffset);
+            }
+        }
+    }
+    buffer->endDataPtr();
+    return true;
+}
+
+void Aquamarine::CHeadlessBackend::emitVinixKey(uint32_t key, bool pressed) {
+    if (key && keyboard)
+        keyboard->events.key.emit(IKeyboard::SKeyEvent{.timeMs = monotonicMs(), .key = key, .pressed = pressed});
+}
+
+void Aquamarine::CHeadlessBackend::parseVinixKeyboard() {
+    auto tap = [this](uint32_t key, uint32_t modifiers) {
+        const bool shift = modifiers & 1, alt = modifiers & 2, control = modifiers & 4, super = modifiers & 8;
+        if (shift) emitVinixKey(KEY_LEFTSHIFT, true);
+        if (alt) emitVinixKey(KEY_LEFTALT, true);
+        if (control) emitVinixKey(KEY_LEFTCTRL, true);
+        if (super && !superDown) {
+            emitVinixKey(KEY_LEFTMETA, true);
+            superDown = true;
+        }
+        emitVinixKey(key, true);
+        emitVinixKey(key, false);
+        if (control) emitVinixKey(KEY_LEFTCTRL, false);
+        if (alt) emitVinixKey(KEY_LEFTALT, false);
+        if (shift) emitVinixKey(KEY_LEFTSHIFT, false);
+    };
+
+    while (!keyboardPending.empty()) {
+        if (keyboardPending.starts_with("\x1B[")) {
+            if (keyboardPending.size() >= 3) {
+                const char final = keyboardPending[2];
+                uint32_t key = final == 'A' ? KEY_UP : final == 'B' ? KEY_DOWN : final == 'C' ? KEY_RIGHT : final == 'D' ? KEY_LEFT :
+                               final == 'H' ? KEY_HOME : final == 'F' ? KEY_END : 0;
+                if (key) {
+                    tap(key, 0);
+                    keyboardPending.erase(0, 3);
+                    continue;
+                }
+            }
+            const auto u = keyboardPending.find('u', 2);
+            if (u != std::string::npos) {
+                const auto semicolon = keyboardPending.find(';', 2);
+                if (semicolon == std::string::npos || semicolon > u) {
+                    keyboardPending.erase(0, u + 1);
+                    continue;
+                }
+                uint32_t codepoint = 0, modifierParam = 1;
+                auto first = keyboardPending.data() + 2;
+                auto middle = keyboardPending.data() + semicolon;
+                std::from_chars(first, middle, codepoint);
+                const auto colon = keyboardPending.find(':', semicolon + 1);
+                auto modifierEnd = keyboardPending.data() + ((colon != std::string::npos && colon < u) ? colon : u);
+                std::from_chars(middle + 1, modifierEnd, modifierParam);
+                bool release = colon != std::string::npos && colon < u && keyboardPending.substr(colon + 1, u - colon - 1) == "3";
+                keyboardPending.erase(0, u + 1);
+                if (codepoint == 57444) {
+                    if (release && superDown) {
+                        emitVinixKey(KEY_LEFTMETA, false);
+                        superDown = false;
+                    }
+                    continue;
+                }
+                uint32_t key = codepoint < 128 ? keyForASCII((char)codepoint) : 0;
+                if (key)
+                    tap(key, modifierParam > 0 ? modifierParam - 1 : 0);
+                continue;
+            }
+            if (keyboardPending.size() >= 4 && keyboardPending[3] == '~') {
+                uint32_t key = keyboardPending[2] == '3' ? KEY_DELETE : keyboardPending[2] == '2' ? KEY_INSERT :
+                               keyboardPending[2] == '5' ? KEY_PAGEUP : keyboardPending[2] == '6' ? KEY_PAGEDOWN : 0;
+                if (key)
+                    tap(key, 0);
+                keyboardPending.erase(0, 4);
+                continue;
+            }
+            if (keyboardPending.size() < 3)
+                return;
+            keyboardPending.erase(0, 1);
+            tap(KEY_ESC, 0);
+            continue;
+        }
+
+        unsigned char c = (unsigned char)keyboardPending[0];
+        keyboardPending.erase(0, 1);
+        if (c == 0x1B) {
+            if (!keyboardPending.empty()) {
+                const char alt = keyboardPending[0];
+                keyboardPending.erase(0, 1);
+                tap(keyForASCII(alt), 2 | (asciiNeedsShift(alt) ? 1 : 0));
+            } else
+                tap(KEY_ESC, 0);
+        } else if (c >= 1 && c <= 26)
+            tap(c == 9 ? KEY_TAB : c == 10 || c == 13 ? KEY_ENTER : keyForASCII('a' + c - 1), c == 9 || c == 10 || c == 13 ? 0 : 4);
+        else
+            tap(keyForASCII((char)c), asciiNeedsShift((char)c) ? 1 : 0);
+    }
+}
+
+void Aquamarine::CHeadlessBackend::pollVinixInput() {
+    // Clear the readiness that dispatched us before emitting callbacks. A
+    // software-rendered frame can take longer than one timer period; if its
+    // expirations were drained afterwards, the event loop would lose the
+    // edge that requests the following frame.
+    uint64_t expirations = 0;
+    read(inputTimerFD, &expirations, sizeof(expirations));
+
+    // Hyprland starts Aquamarine before constructing its input manager. DRM
+    // input discovery is normally asynchronous, so publish the console
+    // devices on the first timer dispatch after its event loop is ready.
+    if (!inputPublished) {
+        backend->events.newKeyboard.emit(keyboard);
+        if (pointerFD >= 0)
+            backend->events.newPointer.emit(pointer);
+        inputPublished = true;
+    }
+
+    const auto now = std::chrono::steady_clock::now();
+    constexpr auto FRAME_INTERVAL = std::chrono::nanoseconds(TIMESPEC_NSEC_PER_SEC / 60);
+    for (const auto& output : outputs) {
+        if (output->frameScheduled && now - output->lastFrame >= FRAME_INTERVAL && output->framecb && *output->framecb)
+            (*output->framecb)();
+    }
+
+    if (pointerFD >= 0 && pointer) {
+        SVinixPointerPacket packet = {};
+        // /dev/pointer is a current-state snapshot, not an event queue: every
+        // read succeeds. Read it exactly once per tick so this callback can
+        // return to the compositor event loop.
+        if (read(pointerFD, &packet, sizeof(packet)) == (ssize_t)sizeof(packet)) {
+            const uint32_t time = monotonicMs();
+            if (packet.maxX > 0 && packet.maxY > 0)
+                pointer->events.warp.emit(IPointer::SWarpEvent{.timeMs = time, .absolute = {(double)packet.x / packet.maxX, (double)packet.y / packet.maxY}});
+            for (uint32_t i = 0; i < 3; ++i) {
+                const uint32_t bit = 1U << i;
+                if (packet.pressed & bit)
+                    pointer->events.button.emit(IPointer::SButtonEvent{.timeMs = time, .button = BTN_LEFT + i, .pressed = true});
+                if (packet.released & bit)
+                    pointer->events.button.emit(IPointer::SButtonEvent{.timeMs = time, .button = BTN_LEFT + i, .pressed = false});
+            }
+            if (packet.scroll)
+                pointer->events.axis.emit(IPointer::SAxisEvent{.timeMs = time, .axis = IPointer::AQ_POINTER_AXIS_VERTICAL,
+                    .source = IPointer::AQ_POINTER_AXIS_SOURCE_WHEEL, .delta = -15.0 * packet.scroll, .discrete = -(double)packet.scroll});
+            pointer->events.frame.emit();
+            pointerButtons = packet.buttons;
+        }
+    }
+
+    char bytes[128];
+    ssize_t count = 0;
+    while ((count = read(STDIN_FILENO, bytes, sizeof(bytes))) > 0)
+        keyboardPending.append(bytes, (size_t)count);
+    parseVinixKeyboard();
+}
+#endif
