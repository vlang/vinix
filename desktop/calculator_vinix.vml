Screen {
    id: root
    width: app.width
    height: app.height
    background: #333333
    property f64 panel_width: app.panel_width
    property f64 panel_height: 340
    property f64 panel_x: app.panel_x
    property f64 panel_y: app.panel_y
    property f64 padding: 12
    property f64 spacing: 8
    property f64 content_width: root.panel_width - root.padding * 2
    property f64 button_width: (root.content_width - root.spacing * 3) / 4
    property f64 button_height: root.button_width

    Rectangle {
        id: calculator
        x: root.panel_x
        y: root.panel_y
        width: root.panel_width
        height: root.panel_height
        background: #333333

        Label {
            id: display
            text: "0"
            x: root.padding
            y: 4
            width: root.content_width
            height: 52
            color: #FFFFFF
            font_size: 40
            align: right
        }

        Button { text: "AC" on_tap: "C" x: root.padding + 0 * (root.button_width + root.spacing) y: 64 + 0 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #707070 color: #FFFFFF font_size: 16 align: center corner_radius: root.button_width / 2 }
        Button { text: "±" on_tap: "±" x: root.padding + 1 * (root.button_width + root.spacing) y: 64 + 0 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #707070 color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "%" on_tap: "%" x: root.padding + 2 * (root.button_width + root.spacing) y: 64 + 0 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #707070 color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "÷" on_tap: "÷" x: root.padding + 3 * (root.button_width + root.spacing) y: 64 + 0 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #FF9F0A color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }

        Button { text: "7" on_tap: "7" x: root.padding + 0 * (root.button_width + root.spacing) y: 64 + 1 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #5C5C5C color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "8" on_tap: "8" x: root.padding + 1 * (root.button_width + root.spacing) y: 64 + 1 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #5C5C5C color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "9" on_tap: "9" x: root.padding + 2 * (root.button_width + root.spacing) y: 64 + 1 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #5C5C5C color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "×" on_tap: "*" x: root.padding + 3 * (root.button_width + root.spacing) y: 64 + 1 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #FF9F0A color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }

        Button { text: "4" on_tap: "4" x: root.padding + 0 * (root.button_width + root.spacing) y: 64 + 2 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #5C5C5C color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "5" on_tap: "5" x: root.padding + 1 * (root.button_width + root.spacing) y: 64 + 2 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #5C5C5C color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "6" on_tap: "6" x: root.padding + 2 * (root.button_width + root.spacing) y: 64 + 2 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #5C5C5C color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "−" on_tap: "-" x: root.padding + 3 * (root.button_width + root.spacing) y: 64 + 2 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #FF9F0A color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }

        Button { text: "1" on_tap: "1" x: root.padding + 0 * (root.button_width + root.spacing) y: 64 + 3 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #5C5C5C color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "2" on_tap: "2" x: root.padding + 1 * (root.button_width + root.spacing) y: 64 + 3 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #5C5C5C color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "3" on_tap: "3" x: root.padding + 2 * (root.button_width + root.spacing) y: 64 + 3 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #5C5C5C color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "+" on_tap: "+" x: root.padding + 3 * (root.button_width + root.spacing) y: 64 + 3 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #FF9F0A color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }

        Button { text: "^" on_tap: "^" x: root.padding + 0 * (root.button_width + root.spacing) y: 64 + 4 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #707070 color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "0" on_tap: "0" x: root.padding + 1 * (root.button_width + root.spacing) y: 64 + 4 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #5C5C5C color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "." on_tap: "." x: root.padding + 2 * (root.button_width + root.spacing) y: 64 + 4 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #5C5C5C color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }
        Button { text: "=" on_tap: "=" x: root.padding + 3 * (root.button_width + root.spacing) y: 64 + 4 * (root.button_height + root.spacing) width: root.button_width height: root.button_height background: #FF9F0A color: #FFFFFF font_size: 22 align: center corner_radius: root.button_width / 2 }

    }
}
