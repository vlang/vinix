#! /bin/sh

name=v
repology_id=vlang
version=0.0git
revision=2
git_url="https://github.com/vlang/v.git"
commit=dd859eae55cf4e69346851fe285b9af104c8ffb7
source_allow_network="yes"
source_imagedeps="git"
hostdeps="gcc"
deps="core-libs"

prepare() {
    # `git clone --revision` is not available in Debian 13's Git 2.47.
    # Fetching the pinned commit explicitly keeps this shallow and portable.
    git init vc
    git -C vc fetch --depth=1 \
        https://github.com/vlang/vc.git \
        216b1cdc8b1acad5b03e9cf8767f44f2742bf8f5
    git -C vc -c advice.detachedHead=false checkout --detach FETCH_HEAD

    cd vc
    rm -rf .git
    patch -p0 <"${base_dir}"/build-support/v/v.c.patch
}

build() {
    cp -rpf ${source_dir}/. ./

    set -x
    ${OS_TRIPLET}-gcc $TARGET_CFLAGS $TARGET_CPPFLAGS -w -std=gnu99 $TARGET_LDFLAGS vc/v.c -o v
    set +x
}

package() {
    rm -rf "${dest_dir}${prefix}"/v
    mkdir -p "${dest_dir}${prefix}"/v
    cp -r . "${dest_dir}${prefix}"/v/
    rm -rf "${dest_dir}${prefix}"/v/.git

    mkdir -p "${dest_dir}${prefix}"/bin
    ln -sf ../v/v "${dest_dir}${prefix}"/bin/v

    # The package contains the complete V source tree.  Avoid running the
    # generic strip helper (and therefore `file`) over every source file.
    ${OS_TRIPLET}-strip "${dest_dir}${prefix}"/v/v
}
