#!/bin/sh
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo=$here
while [ ! -f "$repo/build-support/musl/legacy.v" ]; do
    [ "$repo" != / ] || { printf 'Native musl stager repository not found\n' >&2; exit 1; }
    repo=$(dirname -- "$repo")
done
exec "$repo/build-support/run-v-tool.sh" "$repo/build-support/musl/legacy.v" "$here/stage" "$@"
