+			if (ctx.active[sc] && !ctx.active[sc]->avail_mask)
+				activate_group(ctx.active[sc]);
+			struct mapinfo mi = free_group(g);
+			if (mi.len && !munmap(mi.base, mi.len)) released = 1;
+		}
+	}
+	unlock();
+	errno = saved_errno;
+	return released;
+}
