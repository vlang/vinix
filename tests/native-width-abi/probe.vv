module main

#include "@VMODROOT/native-abi.h"

struct NativeWords {
	unsigned_value u64
	signed_value   i64
	address        voidptr
}

@[export: 'vinix_probe_size_roundtrip']
fn size_roundtrip(value C.size_t) C.size_t {
	return value
}

fn C.vinix_probe_size_roundtrip(C.size_t) C.size_t
fn C.vinix_native_words_size() C.size_t
fn C.vinix_native_signed_offset() C.size_t
fn C.vinix_native_address_offset() C.size_t
fn C.vinix_probe_memcpy(voidptr, voidptr, C.size_t) voidptr
fn C.vinix_probe_memset(voidptr, i32, C.size_t) voidptr
fn C.vinix_probe_memmove(voidptr, voidptr, C.size_t) voidptr
fn C.vinix_probe_memcmp(voidptr, voidptr, C.size_t) i32
fn C.vinix_probe_erase(voidptr, C.size_t)

fn check_native_words() {
	mut byte := u8(7)
	words := NativeWords{
		unsigned_value: 0xfedcba9876543210
		signed_value:   -0x123456789
		address:        voidptr(&byte)
	}
	assert sizeof(u64) == sizeof(voidptr)
	assert sizeof(i64) == sizeof(voidptr)
	assert sizeof(NativeWords) == C.vinix_native_words_size()
	assert u64(&words.signed_value) - u64(&words) == C.vinix_native_signed_offset()
	assert u64(&words.address) - u64(&words) == C.vinix_native_address_offset()
	assert C.vinix_probe_size_roundtrip(words.unsigned_value) == words.unsigned_value
	assert words.signed_value == -i64(0x123456789)
	assert u64(words.address) == u64(&byte)
	// The two page-cache allocations have this fixed 128 KiB size. It fits
	// both a 32-bit compatibility int and the current native-width int.
	allocation := unsafe { malloc(int(u64(32) * u64(4096))) }
	unsafe {
		allocation[131071] = 19
		assert allocation[131071] == 19
		free(allocation)
	}
}

fn check_memory_primitives() {
	for offset in [0, 1, 3, 7] {
		for length in [0, 1, 7, 8, 63, 64, 65, 79, 128] {
			mut source := [256]u8{}
			mut dest := [256]u8{init: 0xa5}
			for i in 0 .. source.len {
				source[i] = u8((i * 13 + 7) & 255)
			}
			unsafe {
				assert C.vinix_probe_memcpy(&dest[offset], &source[offset], u64(length)) ==
					voidptr(&dest[offset])
			}
			for i in 0 .. dest.len {
				expected := if i >= offset && i < offset + length { source[i] } else { u8(0xa5) }
				assert dest[i] == expected
			}
			unsafe {
				assert C.vinix_probe_memcmp(&dest[offset], &source[offset], u64(length)) == 0
				assert C.vinix_probe_memset(&dest[offset], 0x5c, u64(length)) == voidptr(&dest[offset])
			}
			for i in 0 .. dest.len {
				expected := if i >= offset && i < offset + length { u8(0x5c) } else { u8(0xa5) }
				assert dest[i] == expected
			}
			unsafe { C.vinix_probe_erase(&dest[offset], u64(length)) }
			for i in 0 .. dest.len {
				expected := if i >= offset && i < offset + length { u8(0) } else { u8(0xa5) }
				assert dest[i] == expected
			}
		}
	}
	mut data := [256]u8{}
	for i in 0 .. data.len {
		data[i] = u8(i)
	}
	unsafe {
		assert C.vinix_probe_memmove(&data[7], &data[0], 128) == voidptr(&data[7])
	}
	for i in 0 .. 128 {
		assert data[i + 7] == u8(i)
	}
	unsafe {
		assert C.vinix_probe_memmove(&data[0], &data[7], 128) == voidptr(&data[0])
	}
	for i in 0 .. 128 {
		assert data[i] == u8(i)
	}
	mut lower := u8(1)
	mut higher := u8(2)
	unsafe {
		assert C.vinix_probe_memcmp(&lower, &higher, 1) < 0
		assert C.vinix_probe_memcmp(&higher, &lower, 1) > 0
	}
}

fn main() {
	check_native_words()
	check_memory_primitives()
	println('native width and production memory ABI passed')
}
