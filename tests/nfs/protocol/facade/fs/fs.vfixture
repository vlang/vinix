module fs
import resource
import klock
#flag -Dkprintf=printf
__global (
 children_lock klock.Lock
 vfs_root &VFSNode
)
pub const ms_rdonly = u64(1)
pub struct VFSNode {
pub mut:
	resource &resource.Resource = unsafe { nil }
	filesystem &FileSystem = unsafe { nil }
	name string
	parent &VFSNode = unsafe { nil }
	children &map[string]&VFSNode = unsafe { nil }
	read_only bool
	removed bool
	mount_covered bool
}
pub fn create_node(f &FileSystem, p &VFSNode, name string, dir bool) &VFSNode {
	mut n := &VFSNode{filesystem: unsafe { f }, parent: unsafe { p }, name: name}
	if dir { n.children = &map[string]&VFSNode{} }
	return n
}
pub fn (mut n VFSNode) create_dotentries(_ &VFSNode) {}
pub fn publish_child(p &VFSNode, name string, n &VFSNode) { unsafe { p.children[name] = n } }
pub fn free_after_grace(_ voidptr) {}
fn lookup_child(n &VFSNode, name string) &VFSNode {
 if name !in n.children { return unsafe { nil } }
 return unsafe { n.children[name] }
}
pub fn get_node(_ &VFSNode, _ string, _ bool) ?&VFSNode { return none }
