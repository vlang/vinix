module main

import nfs

struct Rig {
mut:
	tx [nfs.capacity+4]u8
	rx [nfs.capacity]u8
	reply [nfs.capacity+1024]u8
	n int
	at int
	sends int
	fail bool
	procedure u32
	program u32
	version u32
	sent [nfs.capacity+4]u8
	sent_len int
}

fn transfer(context voidptr, p &u8, n int, send bool) bool {
	mut rig := unsafe { &Rig(context) }
	if rig.fail { return false }
	if send {
		rig.sends++
		mut r := nfs.Xdr{p: unsafe { p }, n: n}
		assert r.u32() == 0x80000000 | u32(n-4)
		assert r.u32() != 0
		assert r.u32() == 0 && r.u32() == 2
		rig.program = r.u32(); rig.version = r.u32()
		rig.procedure = r.u32()
		assert r.u32() == 1
		credential := r.opaque(400)
		mut auth := nfs.Xdr{p: credential.str, n: credential.len}
		auth.u32(); assert auth.opaque(255) == 'vinix'
		auth.u32(); auth.u32()
		groups := auth.u32()
		for _ in 0 .. int(groups) { auth.u32() }
		assert auth.finished()
		assert r.u32() == 0 && r.u32() == 0
		nfs.copy_bytes(unsafe { &rig.sent[0] }, p, n)
		rig.sent_len = n
		return true
	}
	if !nfs.span(rig.n, rig.at, n) { return false }
	nfs.copy_bytes(p, unsafe { &rig.reply[rig.at] }, n)
	rig.at += n
	return true
}

fn client(rig &Rig) nfs.Client {
	return nfs.Client{context: unsafe { rig }, transfer: transfer, tx: unsafe { &rig.tx[0] }, rx: unsafe { &rig.rx[0] }}
}

fn reply(rig &Rig, status u32) nfs.Xdr {
	unsafe { rig.at = 0; rig.n = 0 }
	return append_reply(rig, 1, status)
}

fn append_reply(rig &Rig, xid u32, status u32) nfs.Xdr {
	mut w := nfs.Xdr{p: unsafe { &rig.reply[rig.n] }, n: nfs.capacity-rig.n}
	w.put32(0) // record marker filled by end_reply
	w.put32(xid); w.put32(1); w.put32(0); w.put32(0); w.put32(0); w.put32(0)
	w.put32(status)
	return w
}

fn end_reply(rig &Rig, w &nfs.Xdr) {
	assert !w.bad
	mut m := nfs.Xdr{p: w.p, n: 4}
	m.put32(0x80000000 | u32(w.at-4))
	unsafe { rig.n = int(usize(w.p)-usize(&rig.reply[0])) + w.at }
}

fn fh() nfs.FileHandle {
	mut h := nfs.FileHandle{len: 4}
	h.bytes[0] = 42
	return h
}

fn attributes(mut w nfs.Xdr) {
	w.put32(1); w.put32(0o644); w.put32(1); w.put32(0); w.put32(0)
	w.put64(42); w.put64(512); w.put32(0); w.put32(0)
	w.put64(7); w.put64(9)
	for _ in 0 .. 3 { w.put32(1); w.put32(0) }
}

fn test_xdr() {
	mut data := [256]u8{}
	for size in [u32(0x7fffffff), 0xffffffff, 65537] {
		mut w := nfs.Xdr{p: unsafe { &data[0] }, n: 4}
		w.put32(size)
		mut r := nfs.Xdr{p: unsafe { &data[0] }, n: 4}
		r.opaque(65536); assert r.bad
	}
	mut w := nfs.Xdr{p: unsafe { &data[0] }, n: 256}
	w.text('abc', 255)
	for n in 0 .. 8 {
		mut r := nfs.Xdr{p: unsafe { &data[0] }, n: n}
		r.opaque(255); assert r.bad
	}
	mut r := nfs.Xdr{p: unsafe { &data[0] }, n: 8}
	assert r.opaque(255) == 'abc' && r.finished()
	data[7] = 1
	r = nfs.Xdr{p: unsafe { &data[0] }, n: 8}; r.opaque(255); assert r.bad
	w = nfs.Xdr{p: unsafe { &data[0] }, n: 4}; w.put32(2)
	r = nfs.Xdr{p: unsafe { &data[0] }, n: 4}; r.boolean(); assert r.bad
	r = nfs.Xdr{p: unsafe { &data[0] }, n: 4, at: 2147483647}; r.u32(); assert r.bad
	assert !nfs.span(2147483647, 2147483640, 10)
	mut a := nfs.Attr{}
	w = nfs.Xdr{p: unsafe { &data[0] }, n: 256}; attributes(mut w)
	for n in 0 .. w.at {
		r = nfs.Xdr{p: unsafe { &data[0] }, n: n}; r.attr(unsafe { &a }); assert r.bad
	}
	println('XDR: hostile lengths, overflow, truncated attributes, strict bool/padding')
}

fn test_options() {
	mut o := nfs.Options{}
	assert nfs.parse_options('ro,soft,rsize=512,wsize=65536,vers=3,proto=tcp,sec=sys', unsafe { &o })
	assert o.ro && o.soft && o.rsize == 512 && o.wsize == 65536
	for s in ['rsize=65537', 'wsize=4294967296', 'rsize=0', 'ro,rw', 'hard,soft', 'vers=4', 'sec=krb5', 'proto=udp', 'ro,', ',ro', 'timeo=1'] {
		assert !nfs.parse_options(s, unsafe { &o }), s
	}
	mut address := u32(0)
	mut path := ''
	assert nfs.parse_source('192.168.1.2:/export/a', unsafe { &address }, unsafe { &path })
	assert path == '/export/a' && address == 0x0201a8c0
	mut host := ''
	assert nfs.parse_host_source('fecv3:/export/share', unsafe { &host }, unsafe { &path })
	assert host == 'fecv3' && path == '/export/share'
	assert nfs.resolve_hosts('# ignored\n::1 fecv3\n10.0.2.2 canonical fecv3 # alias\n', host, unsafe { &address })
	assert address == 0x0202000a
	for text in ['10.0.2.2 fecv30\n', '999.0.2.2 fecv3\n', '10.0.2.2 other # fecv3\n', '10.0.2.2 fecv3\n10.0.2.3 fecv3', '10.0.2.2 fecv3\x00', 'x'.repeat(1025), '10.0.2.2 ' + 'x'.repeat(254) + ' fecv3'] {
		assert !nfs.resolve_hosts(text, 'fecv3', unsafe { &address })
	}
	assert !nfs.resolve_hosts(' '.repeat(nfs.hosts_max+1), 'fecv3', unsafe { &address })
	assert nfs.resolve_hosts('10.0.2.2\tfecv3\r\n', 'fecv3', unsafe { &address })
	for s in ['fecv3:export', 'fecv3:/x\x00', '-host:/a', 'host..name:/a', 'host-:/a', 'host:/a\n', '256.1.1.1:/a', '1.2.3:/a'] {
		assert !nfs.parse_host_source(s, unsafe { &host }, unsafe { &path }), s
	}
	for s in ['256.1.1.1:/a', '1.2.3:/a', '1.2.3.4:a', 'host:/a', '1.2.3.4:/a\x00'] {
		assert !nfs.parse_source(s, unsafe { &address }, unsafe { &path })
	}
}

fn test_rpc() {
	mut rig := &Rig{}
	defer { unsafe { free(rig) } }
	mut c := client(rig)
	mut w := reply(rig, 0)
	w.at -= 4 // NULL has no NFS status
	end_reply(rig, unsafe { &w })
	c.null() or { panic('NULL') }
	assert rig.procedure == 0 && !c.dead
	// Two fragments, including an empty first fragment.
	mut m := nfs.Xdr{p: unsafe { &rig.reply[0] }, n: 4}; m.put32(0)
	mut tail := nfs.Xdr{p: unsafe { &rig.reply[4] }, n: 4}; tail.put32(0x80000018)
	mut body := nfs.Xdr{p: unsafe { &rig.reply[8] }, n: 24}
	body.put32(2); body.put32(1); body.put32(0); body.put32(0); body.put32(0); body.put32(0)
	rig.n = 32; rig.at = 0
	c.null() or { panic('fragments') }
	// Oversized marker poisons, and subsequent operations do not send.
	m = nfs.Xdr{p: unsafe { &rig.reply[0] }, n: 4}; m.put32(0xffffffff)
	rig.n = 4; rig.at = 0
	c.null() or {}
	assert c.dead
	sends := rig.sends
	c.null() or {}; assert rig.sends == sends
	c = client(rig)
	for i in 0 .. nfs.max_fragments { rig.reply[i*4] = 0; rig.reply[i*4+1] = 0; rig.reply[i*4+2] = 0; rig.reply[i*4+3] = 0 }
	rig.n = nfs.max_fragments*4; rig.at = 0
	c.null() or {}; assert c.dead
	c = client(rig); rig.fail = true
	c.null() or {}; assert c.dead && c.fault == 110
	println('RPC: AUTH_SYS, fragmented/empty records, budget, poison and no replay')
}

fn test_operations() {
	mut rig := &Rig{}
	defer { unsafe { free(rig) } }
	h := fh()
	mut a := nfs.Attr{}
	mut out := [16]u8{}
	mut c := client(rig)
	mut w := reply(rig, 0); attributes(mut w); end_reply(rig, unsafe { &w })
	c.getattr(unsafe { &h }, unsafe { &a }) or { panic('GETATTR') }
	assert a.size == 42 && a.fileid == 9 && rig.procedure == 1
	c = client(rig); w = reply(rig, 30); w.put32(0); w.put32(0); end_reply(rig, unsafe { &w })
	c.write(unsafe { &h }, 0, unsafe { &out[0] }, 1) or {}
	assert c.fault == 30 && !c.dead && rig.procedure == 7
	c = client(rig); c.ro = true
	sends := rig.sends
	c.remove(unsafe { &h }, 'x', false) or {}; assert c.fault == 30 && rig.sends == sends
	// READ count and opaque length must agree, and must not exceed request.
	for n in [u32(4), 0xffffffff] {
		c = client(rig); w = reply(rig, 0); w.put32(0); w.put32(n); w.put32(1); w.text('abc', 16); end_reply(rig, unsafe { &w })
		c.read(unsafe { &h }, 0, unsafe { &out[0] }, 16) or {}; assert c.dead
	}
	c = client(rig); w = reply(rig, 0); w.put32(0); w.put32(3); w.put32(1); w.text('abc', 16); end_reply(rig, unsafe { &w })
	assert c.read(unsafe { &h }, 0, unsafe { &out[0] }, 16) or { -1 } == 3
	assert out[0] == `a`
	// WRITE must honor FILE_SYNC and partial count bounds.
	for stable in [u32(0), 1, 2, 3] {
		c = client(rig); w = reply(rig, 0); w.put32(0); w.put32(0); w.put32(1); w.put32(stable); w.put64(7); end_reply(rig, unsafe { &w })
		c.write(unsafe { &h }, 0, unsafe { &out[0] }, 1) or {}
		assert c.dead == (stable != 2)
	}
	for s in [u32(1), 2, 5, 13, 17, 20, 21, 28, 30, 63, 66, 70, 10001, 10003, 10004, 10008, 0xffffffff] {
		c = client(rig); w = reply(rig, s); end_reply(rig, unsafe { &w })
		c.getattr(unsafe { &h }, unsafe { &a }) or {}; assert c.fault == nfs.status_errno(s) && !c.dead
	}
	println('NFS: attributes, errno statuses, ROFS/local ro, READ/WRITE bounds and FILE_SYNC')
}

fn test_directory() {
	mut rig := &Rig{}
	defer { unsafe { free(rig) } }
	h := fh()
	for cookie in [u64(0), 5, 0xffffffffffffffff] {
		mut c := client(rig)
		mut w := reply(rig, 0); w.put32(0); w.put64(7)
		w.put32(1); w.put64(9); w.text('file',255); w.put64(cookie); w.put32(0); w.put32(0)
		w.put32(0); w.put32(1); end_reply(rig, unsafe { &w })
		mut verifier := u64(0)
		mut eof := false
		c.readdirplus(unsafe { &h }, 5, 7, unsafe { &verifier }, unsafe { &eof }) or {}
		assert c.dead == (cookie == 0 || cookie == 5)
	}
	mut c := client(rig)
	mut w := reply(rig, 0); w.put32(0); w.put64(9); w.put32(0); w.put32(0); end_reply(rig, unsafe { &w })
	mut verifier := u64(0); mut eof := false
	c.readdirplus(unsafe { &h }, 0, 0, unsafe { &verifier }, unsafe { &eof }) or {}; assert c.dead
	mut cookies := [nfs.max_entries]u64{}
	assert nfs.remember_cookie(unsafe { &cookies[0] }, 0, 900)
	assert nfs.remember_cookie(unsafe { &cookies[0] }, 1, 7)
	assert nfs.remember_cookie(unsafe { &cookies[0] }, 2, 0xffffffffffffffff)
	assert !nfs.remember_cookie(unsafe { &cookies[0] }, 3, 900)
	assert !nfs.remember_cookie(unsafe { &cookies[0] }, 3, 0)
	assert !nfs.remember_cookie(unsafe { &cookies[0] }, nfs.max_entries, 1)
	println('READDIRPLUS: opaque high cookies, no-progress cookie and empty-page rejection')
}

fn test_all_procedures() {
	mut rig := &Rig{}
	defer { unsafe { free(rig) } }
	h := fh()
	mut c := client(rig)
	mut w := reply(rig, 2049); end_reply(rig, unsafe { &w })
	assert c.getport(100003, 3) or { u16(0) } == 2049
	assert rig.program == 100000 && rig.version == 2 && rig.procedure == 3
	for port in [u32(0), 65536, 0xffffffff] {
		c = client(rig); w = reply(rig, port); end_reply(rig, unsafe { &w })
		c.getport(100005, 3) or {}; assert c.fault == 111 && !c.dead
	}
	mut out := nfs.FileHandle{}
	c = client(rig); w = reply(rig, 0); w.put_handle(unsafe { &h }); w.put32(1); w.put32(1); end_reply(rig, unsafe { &w })
	c.mount_export('/export', unsafe { &out }) or { panic('MNT') }
	assert out.len == 4 && rig.program == 100005 && rig.procedure == 1
	c = client(rig); w = reply(rig, 13); end_reply(rig, unsafe { &w })
	c.mount_export('/denied', unsafe { &out }) or {}; assert c.fault == 13 && !c.dead
	// No AUTH_SYS flavor: successful MNT is paired with bounded UMNT cleanup.
	c = client(rig); w = reply(rig, 0); w.put_handle(unsafe { &h }); w.put32(1); w.put32(6); end_reply(rig, unsafe { &w })
	w = append_reply(rig, 2, 0); w.at -= 4; end_reply(rig, unsafe { &w })
	c.mount_export('/export', unsafe { &out }) or {}; assert c.fault == 95 && rig.procedure == 3
	c = client(rig); w = reply(rig, 0); w.at -= 4; end_reply(rig, unsafe { &w })
	c.unmount_export('/export') or { panic('UMNT') }; assert rig.procedure == 3
	c = client(rig); w = reply(rig, 0); end_reply(rig, unsafe { &w })
	mut exports := c.exports() or { panic('EXPORT') }; assert !exports.boolean() && exports.finished() && rig.procedure == 5
	mut a := nfs.Attr{}
	c = client(rig); w = reply(rig, 0); w.put_handle(unsafe { &h }); w.put32(1); attributes(mut w); w.put32(0); end_reply(rig, unsafe { &w })
	c.lookup(unsafe { &h }, 'file', unsafe { &out }, unsafe { &a }) or { panic('LOOKUP') }; assert rig.procedure == 3 && a.fileid == 9
	// Missing optional LOOKUP attrs are completed with GETATTR.
	c = client(rig); w = reply(rig, 0); w.put_handle(unsafe { &h }); w.put32(0); w.put32(0); end_reply(rig, unsafe { &w })
	w = append_reply(rig, 2, 0); attributes(mut w); end_reply(rig, unsafe { &w })
	c.lookup(unsafe { &h }, 'file', unsafe { &out }, unsafe { &a }) or { panic('LOOKUP fallback') }; assert rig.procedure == 1
	c = client(rig); w = reply(rig, 0); w.put32(0); w.put32(5); end_reply(rig, unsafe { &w })
	assert c.access(unsafe { &h }, 5) or { u32(0) } == 5 && rig.procedure == 4
	set := nfs.SetAttr{mode_set: true, mode: 0o644, size_set: true, size: 7}
	c = client(rig); w = reply(rig, 0); w.put32(0); w.put32(0); end_reply(rig, unsafe { &w })
	c.setattr(unsafe { &h }, unsafe { &set }) or { panic('SETATTR') }; assert rig.procedure == 2
	for dir in [false, true] {
		c = client(rig); w = reply(rig, 0); w.put32(1); w.put_handle(unsafe { &h }); w.put32(1); attributes(mut w); w.put32(0); w.put32(0); end_reply(rig, unsafe { &w })
		c.create(unsafe { &h }, 'new', 0o755, dir, unsafe { &out }, unsafe { &a }) or { panic('CREATE/MKDIR') }
		assert rig.procedure == if dir { u32(9) } else { u32(8) }
		c = client(rig); w = reply(rig, 0); w.put32(0); w.put32(0); end_reply(rig, unsafe { &w })
		c.remove(unsafe { &h }, 'new', dir) or { panic('REMOVE/RMDIR') }
		assert rig.procedure == if dir { u32(13) } else { u32(12) }
	}
	// CREATE with absent optional handle/attrs falls back to LOOKUP.
	c = client(rig); w = reply(rig, 0); w.put32(0); w.put32(0); w.put32(0); w.put32(0); end_reply(rig, unsafe { &w })
	w = append_reply(rig, 2, 0); w.put_handle(unsafe { &h }); w.put32(1); attributes(mut w); w.put32(0); end_reply(rig, unsafe { &w })
	c.create(unsafe { &h }, 'new', 0o644, false, unsafe { &out }, unsafe { &a }) or { panic('CREATE fallback') }
	assert rig.procedure == 3
	c = client(rig); w = reply(rig, 0); for _ in 0 .. 4 { w.put32(0) }; end_reply(rig, unsafe { &w })
	c.rename(unsafe { &h }, 'old', unsafe { &h }, 'new') or { panic('RENAME') }; assert rig.procedure == 14
	mut info := nfs.FsInfo{}
	c = client(rig); w = reply(rig, 0); w.put32(0); for i in 0 .. 6 { w.put64(u64(100+i)) }; w.put32(1); end_reply(rig, unsafe { &w })
	c.fsstat(unsafe { &h }, unsafe { &info }) or { panic('FSSTAT') }; assert info.total == 100 && info.favailable == 105 && rig.procedure == 18
	mut conf := nfs.PathConf{}
	c = client(rig); w = reply(rig, 0); w.put32(0); w.put32(32000); w.put32(255); for _ in 0 .. 4 { w.put32(1) }; end_reply(rig, unsafe { &w })
	c.pathconf(unsafe { &h }, unsafe { &conf }) or { panic('PATHCONF') }; assert conf.namemax == 255 && conf.case_preserving && rig.procedure == 20
	println('Procedure coverage: GETPORT/MNT/UMNT/EXPORT and every requested NFS procedure; optional-arm fallbacks')
}

fn test_rpc_errors() {
	mut rig := &Rig{}
	defer { unsafe { free(rig) } }
	for reason in [u32(0), 1, 2] {
		mut c := client(rig)
		mut w := reply(rig, 0); w.at = 12; w.put32(1); w.put32(reason)
		if reason == 0 { w.put32(2); w.put32(2) } else if reason == 1 { w.put32(1) }
		end_reply(rig, unsafe { &w })
		c.null() or {}
		assert c.dead == (reason == 2)
		if reason < 2 { assert c.fault == if reason == 1 { 13 } else { 95 } }
	}
	for accepted in [u32(1), 2, 3, 4, 5, 6] {
		mut c := client(rig)
		mut w := reply(rig, 0); w.at = 24; w.put32(accepted)
		if accepted == 2 { w.put32(2); w.put32(3) }
		end_reply(rig, unsafe { &w })
		c.null() or {}; assert c.dead == (accepted == 6)
	}
	for off in [4, 8, 12] {
		mut c := client(rig)
		mut w := reply(rig, 0); w.at -= 4; end_reply(rig, unsafe { &w })
		mut corrupt := nfs.Xdr{p: unsafe { &rig.reply[off] }, n: 4}; corrupt.put32(99)
		c.null() or {}; assert c.dead
	}
	println('RPC errors: denied auth/version, accepted error unions, invalid xid/type/reply')
}

fn main() {
	test_xdr(); test_options(); test_rpc(); test_operations(); test_directory(); test_all_procedures(); test_rpc_errors()
	println('NFS protocol fixtures PASS')
}
