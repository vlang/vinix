diff --git a/kernel/proc/nice.v b/kernel/proc/nice.v
index aff4794e5..0b69c4929 100644
--- a/kernel/proc/nice.v
+++ b/kernel/proc/nice.v
@@ -27,6 +27,36 @@ pub fn thread_nice(tid int) ?int {
 	return nice_value(t)
 }
 
+// PRIO_PGRP and PRIO_USER choose the highest priority of every matching
+// task, including nonleader threads. Keep table entries and their owners
+// under the lock and return only a scalar snapshot.
+pub fn aggregate_nice(local int, by_group bool) ?int {
+	lock_table()
+	defer { unlock_table() }
+	caller := current_thread().process
+	viewer := current_pid_namespace()
+	group := if local == 0 { pgid_in(caller, viewer) } else { local }
+	uid := if local == 0 { caller.uid } else { u32(local) }
+	mut best := 20
+	for tid := 1; tid < max_pid; tid++ {
+		t := threads_by_tid[tid]
+		if t == unsafe { nil } { continue }
+		owner := t.process
+		// Exit/exec can detach a thread before removing its TID. Such a
+		// thread no longer belongs to a published user process.
+		if owner == unsafe { nil } || process_at(owner.pid) != owner
+			|| pid_in(owner, viewer) == 0 || tid_in(t, viewer) == 0 { continue }
+		if by_group {
+			if pgid_in(owner, viewer) != group { continue }
+		} else if owner.uid != uid { continue }
+		if !mac_peer_allowed(caller, owner) { errno.set(errno.eperm); return none }
+		value := nice_value(t)
+		if value < best { best = value }
+	}
+	if best == 20 { errno.set(errno.esrch); return none }
+	return best
+}
+
 pub fn set_thread_nice(tid int, wanted int) bool {
 	if tid <= 0 || tid >= max_pid { errno.set(errno.esrch); return false }
 	lock_table()
diff --git a/kernel/syscall/table/linux_common.v b/kernel/syscall/table/linux_common.v
index 0baba180f..51c4ceab2 100644
--- a/kernel/syscall/table/linux_common.v
+++ b/kernel/syscall/table/linux_common.v
@@ -1110,12 +1110,16 @@ fn syscall_linux_setpriority(_ voidptr, raw_which int, raw_local_who int, raw_pr
 fn syscall_linux_getpriority(_ voidptr, raw_which int, raw_local_who int) (u64, u64) {
 	which := int(i32(raw_which))
 	local_who := int(i32(raw_local_who))
-	who := proc.kernel_id(local_who)
-	if which != prio_process {
+	if which < prio_process || which > 2 {
 		return errno.err, errno.einval
 	}
-	target_tid := if who == 0 { proc.current_thread().tid } else { who }
-	nice := proc.thread_nice(target_tid) or { return errno.err, errno.get() }
+	nice := if which == prio_process {
+		who := proc.kernel_id(local_who)
+		target_tid := if who == 0 { proc.current_thread().tid } else { who }
+		proc.thread_nice(target_tid) or { return errno.err, errno.get() }
+	} else {
+		proc.aggregate_nice(local_who, which == 1) or { return errno.err, errno.get() }
+	}
 	// The raw syscall returns 20 - nice so every successful result is positive.
 	return u64(20 - nice), 0
 }
