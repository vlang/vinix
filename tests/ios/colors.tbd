               _CGColorSpaceCreateDeviceGray, _CGColorSpaceGetNumberOfComponents,
               _CGColorSpaceGetModel, _CGContextSetFillColorSpace, _CGContextSetFillColor,
               _CGContextSetFillColorWithColor, _CGContextSetBlendMode, _CGContextFlush ]
...
