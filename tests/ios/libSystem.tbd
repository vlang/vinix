--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios ]
install-name:    '/usr/lib/libSystem.B.dylib'
current-version: 1
exports:
  - targets:     [ arm64-ios ]
    symbols:     [ _puts, _atoi, _malloc, _free, _strlen, _strcmp, _memcpy, _memset, _printf,
                   __tlv_bootstrap, ___cxa_atexit, _pthread_create, _pthread_join, dyld_stub_binder,
                   _memmove, _memcmp, _memchr, _bzero, __Unwind_Resume ]
...
