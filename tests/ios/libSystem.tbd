--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios ]
install-name:    '/usr/lib/libSystem.B.dylib'
current-version: 1
exports:
  - targets:     [ arm64-ios ]
    symbols:     [ _socket, _socketpair, _bind, _connect, _listen, _accept, _getsockname, _getpeername, _shutdown,
                   _send, _recv, _sendto, _recvfrom, _setsockopt, _getsockopt, _inet_pton, _inet_ntop, _inet_addr,
                   _htons, _ntohs, _htonl, _ntohl, _usleep, _atof, _atoll, _chmod, _fchmod, _getpid, _fcntl, _fsync, _read,
                   _puts, _atoi, _malloc, _calloc, _free, _strlen, _strcmp, _memcpy, _memset, _printf, _abort, _mach_msg_server,
                   _CC_SHA1, _CC_SHA224, _CC_SHA256, _CC_SHA384, _CC_SHA512, _CCHmac, _CCCrypt, _CCRandomGenerateBytes,
                   _OSAtomicEnqueue, _OSAtomicDequeue,
                   ___assert_rtn, ___chkstk_darwin,
                   ___maskrune, _isspace, _setlocale, _strcpy,
                   ___darwin_check_fd_set_overflow, ___memmove_chk, ___memcpy_chk, ___memset_chk, ___strcat_chk, ___strncpy_chk,
                   __tlv_bootstrap, ___cxa_atexit, ___cxa_finalize, _atexit, _exit, __exit, _pthread_create, _pthread_join, dyld_stub_binder, _setenv, _unsetenv,
                   _memmove, _memcmp, _memchr, _bzero, __Unwind_Resume,
                   _pthread_setspecific, _pthread_getspecific, _pthread_key_create,
                   _pthread_key_delete, _pthread_self, _pthread_once,
                   _pthread_mutex_lock, _pthread_mutex_unlock, _pthread_mutex_init,
                   _pthread_mutex_destroy, _pthread_mutex_trylock,
                   _pthread_cond_wait, _pthread_cond_timedwait, _pthread_cond_signal,
                   _pthread_cond_broadcast, _pthread_cond_init, _pthread_cond_destroy,
                   _snprintf, _vsnprintf, _sscanf, _fprintf, _fopen, _fwrite, _ftell,
                   _rewind, ___srget, _ungetc, _fgets, _clearerr, _fseek, ___swbuf,
                   _fflush, _fread, _fclose, ___stderrp, _sysctlbyname, ___error,
                   _putc, _getc, _feof, _ferror, _dispatch_once_f,
                   _asprintf, ___snprintf_chk, _clock_gettime, _gmtime_r, _strftime,
                   _posix_spawnp, _dlopen, _dlsym, _dlerror, _dlclose,
                   _open, _write, _close, _unlink, _shm_open, _shm_unlink,
                   _ftruncate, _mmap, _munmap, _stat, _fstat, _strstr, _posix_memalign, _pread, _pwrite, _lseek,
                   _dispatch_async, _dispatch_async_f, _dispatch_sync, _dispatch_sync_f,
                   _dispatch_after, _dispatch_after_f, _dispatch_time, _dispatch_walltime,
                   _dispatch_get_main_queue, _dispatch_get_global_queue, _dispatch_queue_create,
                   '_dispatch_queue_create_with_target$V2', _dispatch_queue_get_label,
                   _dispatch_retain, _dispatch_release, _dispatch_set_context, _dispatch_get_context,
                   _dispatch_set_finalizer_f, __NSConcreteGlobalBlock,
                   __NSConcreteStackBlock, __Block_object_assign, __Block_object_dispose,
                   _opendir, _readdir, _closedir, ___tolower, ___toupper,
                   ___exp10, ___exp10f, ___sincos_stret, ___sincosf_stret,
                   _setjmp, _longjmp, __setjmp, __longjmp,
                   _mach_task_self_, _vm_page_size, _vm_allocate, _vm_remap, _vm_deallocate,
                   _memset_pattern4, _memset_pattern8, _memset_pattern16,
                   _wmemchr, _wmemcmp, _wmemcpy, _wmemmove, _wmemset, _wcslen ]
...
