// SPDX-License-Identifier: BSD-2-Clause
// Independent native OS differential driver for the frozen C and V fixtures.
@[translated]
@[has_globals]
module baseoracle

#include <basefixture-api.h>
#include <original-basefixture-api.h>
#include <assert.h>
#include <errno.h>
#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/wait.h>
#include <unistd.h>

@[c_extern]
__global C.errno i32
fn C.assert(bool)
fn C.puts(&char) i32
fn C.strcpy(&char, &char) &char
fn C.mkstemp(&char) i32
fn C.close(i32) i32
fn C.write(i32, voidptr, usize) isize
fn C.unlink(&char) i32
fn C.memset(voidptr, i32, usize) voidptr
fn C.verify_marker(&char, &char, usize) i32
fn C.original_verify_marker(&char, &char, usize) i32
fn C.test_random() i32
fn C.original_test_random() i32
fn C.test_cow() i32
fn C.original_test_cow() i32
fn C.verify_persistence_boot() i32
fn C.original_verify_persistence_boot() i32

__global (
	request_mode i32
	request_count i32
)

// Both immutable C and V callers use this deterministic native API provider.
// Distinct failures exercise every original random-buffer assertion.
@[export: 'getrandom']
pub fn random_provider(buffer voidptr, length usize, flags u32) isize {
	unsafe {
		C.assert(length == 64 && flags == 0)
		request_count++
		if request_mode == 1 {
			C.errno = C.EIO
			return -1
		}
		if request_mode == 2 && request_count == 2 { return 63 }
		fill := if request_mode == 3 { 0 } else if request_mode == 4 { 0x51 } else { 0x40 + request_count }
		C.memset(buffer, fill, length)
		return isize(length)
	}
}

fn marker_case(original bool, length usize, bytes usize, mismatch bool) i32 {
	unsafe {
		mut path := [64]char{}
		C.strcpy(&path[0], c'/tmp/vinix-qemu-base-XXXXXX')
		fd := C.mkstemp(&path[0])
		C.assert(fd >= 0)
		mut content := [80]char{}
		C.memset(&content[0], 0x51, sizeof(content))
		C.assert(C.write(fd, &content[0], bytes) == isize(bytes))
		C.assert(C.close(fd) == 0)
		mut expected := [80]char{}
		C.memset(&expected[0], if mismatch { 0x52 } else { 0x51 }, sizeof(expected))
		C.errno = C.E2BIG
		result := if original {
			C.original_verify_marker(&path[0], &expected[0], length)
		} else {
			C.verify_marker(&path[0], &expected[0], length)
		}
		saved_errno := C.errno
		if result != 0 { C.assert(C.unlink(&path[0]) == 0) }
		return i32((result + 1) * 1000 + saved_errno)
	}
}

@[export: 'main']
pub fn run() i32 {
	unsafe {
		for mode in 0 .. 5 {
			request_mode = i32(mode)
			request_count = 0
			C.errno = C.E2BIG
			original := C.original_test_random()
			original_count := request_count
			original_errno := C.errno
			request_count = 0
			C.errno = C.E2BIG
			ported := C.test_random()
			C.assert(ported == original && request_count == original_count && C.errno == original_errno)
			C.assert(ported == if mode == 0 { 0 } else { 1 })
		}
		for length in [usize(0), 1, 29, 63, 64, 65]! {
			for mismatch in [false, true]! {
				C.assert(marker_case(true, length, length, mismatch) == marker_case(false, length, length, mismatch))
			}
		}
		C.assert(marker_case(true, 29, 28, false) == marker_case(false, 29, 28, false))
		C.assert(marker_case(true, 29, 30, false) == marker_case(false, 29, 30, false))
		C.assert(C.original_test_cow() == 0 && C.test_cow() == 0)
		C.assert(C.original_verify_persistence_boot() == C.verify_persistence_boot())
		C.puts(c'QEMU CORE BASE DIFFERENTIAL PASS')
		run_memory()
		return 0
	}
}
