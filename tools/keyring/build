#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Build vinix-keyring as a static program for a Vinix machine.
#
#   tools/keyring/build aarch64|x86_64 ROOT
#
# puts it in ROOT/usr/bin. The compilers are found as tools/accounts/build
# finds them. -O2 because every unlock waits for scrypt.
set -eu

if [ "$#" -ne 2 ]; then
    echo "usage: $0 aarch64|x86_64 ROOT" >&2
    exit 2
fi
arch=$1
root=$2
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
. "$repo/build-support/find-v.sh"

work=$(mktemp -d "${TMPDIR:-/tmp}/vinix-keyring.XXXXXX")
trap 'rm -rf "$work"' 0
mkdir -p "$root/usr/bin"
output="$root/usr/bin/vinix-keyring"

case "$arch" in
    aarch64)
        sysroot=${VINIX_AARCH64_SYSROOT:-"$repo/build-aarch64-userland/sysroot"}
        "$V" -os linux -arch arm64 -gc none -d no_backtrace -path "@vlib|@vmodules|$repo/tools/accounts" \
            -o "$work/program.c" \
            "$repo/tools/keyring/keyring.v"
        "${CC:-clang}" --target=aarch64-linux-musl --sysroot="$sysroot" -static -O2 -w \
            -D_GNU_SOURCE -fno-stack-protector -L"$sysroot/lib" -fuse-ld=lld \
            -o "$output" "$work/program.c" -lm -lpthread
        ;;
    x86_64)
        "$V" -os linux -arch amd64 -gc none -d no_backtrace -path "@vlib|@vmodules|$repo/tools/accounts" \
            -o "$work/program.c" \
            "$repo/tools/keyring/keyring.v"
        # -fpermissive: V's library passes an i64 where C wants an int
        # pointer, which gcc 14 refuses and clang only warns about.
        "${CC_AMD64:-x86_64-linux-musl-gcc}" -static -O2 -w -fpermissive -D_GNU_SOURCE \
            -o "$output" "$work/program.c" -lm -lpthread
        ;;
    *)
        echo "unknown architecture: $arch" >&2
        exit 2
        ;;
esac
chmod 755 "$output"
