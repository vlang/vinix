# Read the keys the Vinix SMC driver uses from the SMC of this Mac, under
# macOS. Reads only; see smcprobe.v and README.md.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$here/../../build-support/run-v-tool.sh" "$here/smcprobe.v" "$@"
