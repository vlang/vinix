#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Build the account programs as static programs for a Vinix machine and lay
# them out as they are installed.
#
#   tools/accounts/build aarch64|x86_64 ROOT
#
# puts vinix-authd, vinix-account, vinix-session and vinix-system in
# ROOT/usr/sbin, vinix-auth in ROOT/usr/bin and the action files in
# ROOT/usr/share/vinix/actions.
#
# The V compiler is found as for every other build (V, VINIX_V_COMPILER). The
# AArch64 C compiler needs the musl sysroot of the userland build
# (VINIX_AARCH64_SYSROOT, by default build-aarch64-userland/sysroot); the
# x86-64 one is a musl cross compiler (CC_AMD64, by default
# x86_64-linux-musl-gcc).
set -eu

if [ "$#" -ne 2 ]; then
    echo "usage: $0 aarch64|x86_64 ROOT" >&2
    exit 2
fi
arch=$1
root=$2
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
here="$repo/tools/accounts"
. "$repo/build-support/find-v.sh"

work=$(mktemp -d "${TMPDIR:-/tmp}/vinix-accounts.XXXXXX")
trap 'rm -rf "$work"' 0

# -O2: every login waits for scrypt, and V's is three times slower at -O1.
build() {
    source=$1
    output=$2
    case "$arch" in
        aarch64)
            sysroot=${VINIX_AARCH64_SYSROOT:-"$repo/build-aarch64-userland/sysroot"}
            "$V" -os linux -arch arm64 -gc none -d no_backtrace -o "$work/program.c" "$here/$source"
            "${CC:-clang}" --target=aarch64-linux-musl --sysroot="$sysroot" -static -O2 -w \
                -D_GNU_SOURCE -fno-stack-protector -L"$sysroot/lib" -fuse-ld=lld \
                -o "$output" "$work/program.c" -lm -lpthread
            ;;
        x86_64)
            "$V" -os linux -arch amd64 -gc none -d no_backtrace -o "$work/program.c" "$here/$source"
            # -fpermissive: V's library passes an i64 where C wants an int
            # pointer, which gcc 14 refuses and clang only warns about.
            "${CC_AMD64:-x86_64-linux-musl-gcc}" -static -O2 -w -fpermissive -D_GNU_SOURCE \
                -o "$output" "$work/program.c" -lm -lpthread
            ;;
        *)
            echo "unknown architecture: $arch" >&2
            exit 2
            ;;
    esac
    chmod 755 "$output"
}

mkdir -p "$root/usr/sbin" "$root/usr/bin" "$root/usr/share/vinix/actions"
build authd.v "$root/usr/sbin/vinix-authd"
build account.v "$root/usr/sbin/vinix-account"
build session.v "$root/usr/sbin/vinix-session"
build system.v "$root/usr/sbin/vinix-system"
build auth.v "$root/usr/bin/vinix-auth"
for action in "$here"/actions/*; do
    cp "$action" "$root/usr/share/vinix/actions/"
    chmod 644 "$root/usr/share/vinix/actions/$(basename "$action")"
done
chmod 755 "$root/usr/share/vinix/actions"
