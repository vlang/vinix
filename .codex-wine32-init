#!/bin/busybox sh
exec >/dev/console 2>&1
export PATH=/aarch64-linux-musl-native/bin:/usr/local/bin:/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export USER=root
export LOGNAME=root
export SHELL=/bin/busybox
export TERM=linux
export LD_LIBRARY_PATH=/usr/lib:/usr/lib/xorg/modules
export XDG_RUNTIME_DIR=/run/user/0

echo 'VINIX WINE32 BOOT DIAGNOSTIC: START'
echo '--- loader version ---'
WINEDEBUG=+process,+module wine32 --version
echo "loader status: $?"
echo '--- PE32 smoke (30 second timeout) ---'
WINEDEBUG=+process,+module /bin/busybox timeout -s KILL 30 \
    wine32 /usr/share/wine/vinix-wine-smoke32.exe
echo "smoke status: $?"
echo '--- processes after smoke ---'
/bin/busybox ps
echo 'VINIX WINE32 BOOT DIAGNOSTIC: END'
exec /bin/busybox sh
